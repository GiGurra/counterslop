    { "n": 15, "alice": { "exec": "buy rubberduck" } },
    { "expect": { "alice": { "cur": "sidearm", "slots": { "primary": "codereview", "sidearm": "rubberduck", "melee": "keyboard", "he": "mergeconflict" } } } }
