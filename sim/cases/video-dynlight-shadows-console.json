{
  "name": "Muzzle-light shadows from the console: r_dynlight_shadows takes 0-4 lights (default 2) and clamps above; it applies with r_dynflood 1 (Options → Video has the same select)",
  "levels": ["e2e"],
  "players": { "alice": { "pos": [-26, 0, 0], "yaw": 1.57 } },
  "script": [
    { "n": 2, "alice": { "exec": "r_dynlight_shadows" } },
    { "expect": { "alice": { "consoleText": { "contains": "\"r_dynlight_shadows\" = \"2\"" } } } },
    { "n": 2, "alice": { "exec": "r_dynlight_shadows 9; r_dynlight_shadows" } },
    { "expect": { "alice": { "consoleText": { "contains": "\"r_dynlight_shadows\" = \"4\"" } } } },
    { "n": 2, "alice": { "exec": "r_dynlight_shadows 0; r_dynlight_shadows" } },
    { "expect": { "alice": { "consoleText": { "contains": "\"r_dynlight_shadows\" = \"0\"" } } } },
    { "n": 2, "alice": { "exec": "r_dynlight_shadows 2" } }
  ]
}
