    { "expect": { "alice": { "scoped": false } } },
    { "n": 15, "alice": { "b": ["scope"] } },
    { "expect": { "alice": { "scoped": true } } },
    { "n": 100, "alice": { "b": ["scope", "fire"] } },
    { "expect": { "alice": { "shots": 1 } } },
    { "n": 1, "alice": { "b": ["scope"] } },
