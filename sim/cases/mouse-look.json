            "min": 1.4159,
            "max": 1.4169
          },
          "pitch": 0
        }
      }
    },
    {
      "n": 1,
      "alice": {
        "mouse": [
          0,
          100
        ]
      }
    },
    {
      "expect": {
        "alice": {
          "yaw": {
            "min": 1.4159,
            "max": 1.4169
          },
          "pitch": {
            "min": -0.1541,
            "max": -0.1531
          }
        }
      }
    },
    {
      "n": 1,
      "alice": {
        "exec": "m_invert_y 1"
      }
    },
    {
      "n": 1,
      "alice": {
        "mouse": [
          0,
          200
        ]
      }
    },
    {
      "expect": {
        "alice": {
          "pitch": {
            "min": 0.1531,
            "max": 0.1541
          }
        }
      }
    },
    {
      "n": 30,
