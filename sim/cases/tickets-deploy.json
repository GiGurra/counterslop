{
 "name": "Tickets mode on lab_conquest, the spawn choice: the top bar shows each side's ticket backlog and the points strip; alice captures A (the launch pad, a spawn point); bob shoots her dead: the spawn screen comes up (respawning in 3 at Earth's main, AUTO picked); she types deploy A and kit senior: the server shows both, the screen marks them; she respawns at A with Code Review (the Senior Sniper). kit intern puts the remembered kit back.",
 "levels": ["e2e"],
 "map": "lab_conquest",
 "players": {
  "alice": { "team": "vibe", "pos": [-56, 0, 4], "yaw": 0 },
  "bob": { "team": "artisan", "pos": [56, 0, 4], "yaw": 0 }
 },
 "script": [
  { "n": 3, "alice": { "exec": "admin_login x; mp_freezetime 0; mp_warmup_time 0; mp_tickets 10; mp_respawn_delay 3; kit intern" } },
