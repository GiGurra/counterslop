  { "n": 3, "alice": { "exec": "restart" } },
  { "n": 10 },
  { "expect": { "world": { "round.phase": "live", "round.tickets.vibe": 10 },
                "alice": { "backlog": { "contains": "BACKLOG 10 |" }, "pointsStrip": "⌂:vibe A:- B:- C:- D:- E:- ⌂:artisan", "spawnScreen": "", "deployPt": "", "deployKit": "intern" } } },
  { "n": 10, "alice": { "exec": "setpos -32 0 0" }, "bob": { "exec": "setpos 40 0 20" } },
  { "n": 1010 },
  { "expect": { "world": { "round.point.A": "vibe" }, "alice": { "pointsStrip": { "contains": "A:vibe" } } } },
  { "n": 10, "alice": { "exec": "setpos -32 0 2" }, "bob": { "exec": "setpos -32 0 7", "yaw": 0, "pitch": 0 } },
  { "n": 6, "bob": { "b": ["fire"] } }, { "n": 6, "bob": { "b": [] } },
  { "n": 6, "bob": { "b": ["fire"] } }, { "n": 6, "bob": { "b": [] } },
  { "n": 6, "bob": { "b": ["fire"] } }, { "n": 6, "bob": { "b": [] } },
  { "n": 6, "bob": { "b": ["fire"] } }, { "n": 6, "bob": { "b": [] } },
  { "n": 6, "bob": { "b": ["fire"] } }, { "n": 6, "bob": { "b": [] } },
  { "n": 6, "bob": { "b": ["fire"] } }, { "n": 6, "bob": { "b": [] } },
  { "n": 6, "bob": { "b": ["fire"] } }, { "n": 6, "bob": { "b": [] } },
  { "n": 6, "bob": { "b": ["fire"] } }, { "n": 6, "bob": { "b": [] } },
  { "n": 5, "bob": { "exec": "setpos 40 0 20" } },
  { "expect": { "alice": { "dead": true, "deployAt": "A", "spawnScreen": { "contains": "Respawning in" }, "backlog": { "contains": "BACKLOG 9 |" } }, "world": { "round.tickets.vibe": 9 } } },
  { "n": 10, "alice": { "exec": "deploy A; kit senior" } },
  { "n": 20 },
  { "expect": { "alice": { "dead": true, "deployPt": "A", "deployKit": "senior", "spawnScreen": { "contains": "| A,senior" } } } },
  { "n": 300 },
  { "expect": { "alice": { "dead": false, "spawnScreen": "", "pos": [{ "min": -36, "max": -28 }, 0, { "min": -4, "max": 4 }], "cur": "primary", "slots": { "primary": "codereview", "sidearm": "hotfix", "melee": "keyboard" } } } },
  { "n": 3, "alice": { "exec": "kit intern" } },
  { "n": 20 },
  { "expect": { "alice": { "deployKit": "intern" } } }
 ]
}
