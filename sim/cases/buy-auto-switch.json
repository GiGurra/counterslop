{
  "name": "Buying moves your hand only as the operator's rule says (buy <item> in the console): armor, a grenade and ammo never do; a pistol that replaces your pistol goes to hand unless your primary is in hand; any primary (first or replacing) goes to hand. Walked through with the knife, a grenade, the primary and the pistol in hand.",
  "levels": ["e2e"],
  "players": { "alice": { "pos": [-26, 0, 0], "yaw": 1.57, "cur": "melee",
    "slots": { "sidearm": { "id": "stub", "ammo": 12, "reserve": 0 }, "melee": { "id": "keyboard", "ammo": 0, "reserve": 0 } } } },
  "script": [
    { "n": 5 },
    { "expect": { "alice": { "cur": "melee" } } },
    { "n": 15, "alice": { "exec": "buy vest" } },
    { "n": 15, "alice": { "exec": "buy helmet" } },
    { "n": 15, "alice": { "exec": "buy mergeconflict" } },
    { "n": 15, "alice": { "act": ["buyammo2"] } },
    { "expect": { "alice": { "cur": "melee", "slots": { "sidearm": "stub", "melee": "keyboard", "he": "mergeconflict" } } } },
    { "n": 15, "alice": { "exec": "buy hotfix" } },
    { "expect": { "alice": { "cur": "sidearm", "slots": { "sidearm": "hotfix", "melee": "keyboard", "he": "mergeconflict" } } } },
    { "n": 40, "alice": { "w": "he" } },
    { "expect": { "alice": { "cur": "he" } } },
    { "n": 15, "alice": { "exec": "buy vest" } },
    { "expect": { "alice": { "cur": "he" } } },
    { "n": 15, "alice": { "exec": "buy rubberduck" } },
    { "expect": { "alice": { "cur": "sidearm", "slots": { "sidearm": "rubberduck", "melee": "keyboard", "he": "mergeconflict" } } } },
    { "n": 40, "alice": { "w": "he" } },
    { "n": 15, "alice": { "exec": "buy prompt" } },
    { "expect": { "alice": { "cur": "primary", "slots": { "primary": "prompt", "sidearm": "rubberduck", "melee": "keyboard", "he": "mergeconflict" } } } },
    { "n": 40 },
    { "n": 15, "alice": { "exec": "buy hotfix" } },
    { "n": 15, "alice": { "act": ["buyammo1"] } },
    { "expect": { "alice": { "cur": "primary", "slots": { "primary": "prompt", "sidearm": "hotfix", "melee": "keyboard", "he": "mergeconflict" } } } },
    { "n": 40, "alice": { "w": "melee" } },
    { "expect": { "alice": { "cur": "melee" } } },
    { "n": 15, "alice": { "exec": "buy codereview" } },
    { "expect": { "alice": { "cur": "primary", "slots": { "primary": "codereview", "sidearm": "hotfix", "melee": "keyboard", "he": "mergeconflict" } } } }
  ]
}
