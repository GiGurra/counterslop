{
  "name": "Shadow cvars from the console: r_shadow_quality clamps to 0..3, r_light_shadows to 0..8, r_shadowmap_size sets and shows (Options → Video has them); cl_showfps switches; back to the defaults at the end",
  "levels": ["e2e"],
  "players": { "alice": { "pos": [-26, 0, 0], "yaw": 1.57 } },
  "script": [
    { "n": 2, "alice": { "exec": "r_shadow_quality 9; r_shadow_quality" } },
    { "expect": { "alice": { "consoleText": { "contains": "\"r_shadow_quality\" = \"3\"" } } } },
    { "n": 2, "alice": { "exec": "r_light_shadows 9; r_light_shadows" } },
    { "expect": { "alice": { "consoleText": { "contains": "\"r_light_shadows\" = \"8\"" } } } },
    { "n": 2, "alice": { "exec": "r_shadowmap_size 1024; r_shadowmap_size" } },
    { "expect": { "alice": { "consoleText": { "contains": "\"r_shadowmap_size\" = \"1024\"" } } } },
    { "n": 2, "alice": { "exec": "cl_showfps 1; cl_showfps" } },
    { "expect": { "alice": { "consoleText": { "contains": "\"cl_showfps\" = \"1\"" } } } },
    { "n": 1, "alice": { "exec": "r_shadow_quality 2; r_light_shadows 4; r_shadowmap_size 2048; cl_showfps 0" } }
  ]
}
