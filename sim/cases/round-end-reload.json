{
  "name": "Round end mid-reload: a survivor whose reload is still running when the round ends (here the Stub, 2.2 s, started in the round-over pause) gets it finished at the next round's start: the held gun tops up from its own reserve (no free ammo) and the client's predicted reload is reset with it (none left running)",
  "levels": ["e2e"],
  "players": {"alice": {"team": "vibe", "pos": [-26, 0, -10], "yaw": 0}, "bob": {"team": "artisan", "pos": [26, 0, 0], "yaw": 1.57}},
  "script": [
    {"n": 3, "alice": {"exec": "admin_login x; mp_freezetime 0; mp_roundtime 1; mp_round_restart_delay 0.5; mp_maxrounds 30; mp_afk_rounds 0; mp_respawn 0"}},
    {"n": 5, "alice": {"exec": "mp_warmup_end"}},
    {"expect": {"world": {"round.phase": "live", "round.number": 1}}},
    {"n": 120},
    {"expect": {"world": {"round.phase": "over", "round.number": 1}}},
    {"n": 50},
    {"expect": {"world": {"round.phase": "live", "round.number": 2}, "alice": {"cur": "sidearm", "ammo": 12, "reserve": 24}}},
    {"n": 10, "alice": {"pitch": -1.4}},
    {"n": 10, "alice": {"b": ["fire"]}},
    {"n": 10},
    {"n": 10, "alice": {"b": ["fire"]}},
    {"n": 10},
    {"expect": {"alice": {"ammo": 10, "reserve": 24}}},
    {"n": 75},
    {"expect": {"world": {"round.phase": "over", "round.number": 2}}},
    {"n": 1, "alice": {"b": ["reload"]}},
    {"expect": {"alice": {"reloading": true, "ammo": 10, "reserve": 24}}},
    {"n": 60},
    {"expect": {"world": {"round.phase": "live", "round.number": 3}, "alice": {"cur": "sidearm", "reloading": false, "ammo": 12, "reserve": 22}}},
    {"n": 250},
    {"expect": {"alice": {"reloading": false, "ammo": 12, "reserve": 22}}}
  ]
}
