{
  "name": "Muzzle-light flood from the console: r_dynflood 0 (default) lights a shot through its shadow map alone, no light-grid flood; 1 floods from the shot's cell (Options → Video has the same checkbox)",
  "levels": ["e2e"],
  "players": { "alice": { "pos": [-26, 0, 0], "yaw": 1.57, "slots": { "sidearm": { "id": "stub", "ammo": 12, "reserve": 48 } }, "cur": "sidearm" } },
  "script": [
    { "n": 60 },
    { "n": 2, "alice": { "exec": "r_muzzle_light 1; r_dynflood" } },
    { "expect": { "alice": { "consoleText": { "contains": "\"r_dynflood\" = \"0\"" } } } },
    { "n": 1, "alice": { "b": ["fire"] } },
    { "n": 30 },
    { "expect": { "alice": { "shots": 1, "dynLights": 1, "dynFloods": 0 } } },
    { "n": 2, "alice": { "exec": "r_dynflood 1; r_dynflood" } },
    { "expect": { "alice": { "consoleText": { "contains": "\"r_dynflood\" = \"1\"" } } } },
    { "n": 1, "alice": { "b": ["fire"] } },
    { "n": 30 },
    { "expect": { "alice": { "shots": 2, "dynLights": 2, "dynFloods": 1 } } },
    { "n": 2, "alice": { "exec": "r_dynflood 0; r_muzzle_light 0" } }
  ]
}
