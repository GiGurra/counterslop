{
  "name": "Admin (open server): login/logout, status, give, say_admin and every server cvar set or shown from the console",
  "levels": ["e2e"],
  "players": { "alice": { "pos": [-26, 0, 0], "yaw": 1.57 } },
  "script": [
    { "n": 3, "alice": { "exec": "admin_login whatever" } },
    { "n": 3, "alice": { "exec": "rcon help" } },
    { "expect": { "alice": { "consoleText": { "contains": "changelevel" } } } },
    { "n": 3, "alice": { "exec": "rcon status" } },
    { "expect": { "alice": { "consoleText": { "contains": "admin" } } } },
    { "n": 3, "alice": { "exec": "give codereview" } },
    { "expect": { "alice": { "slots": { "primary": "codereview", "sidearm": "stub", "melee": "keyboard" } } } },
    { "n": 3, "alice": { "exec": "say_admin slop-is-law" } },
    { "expect": { "alice": { "consoleText": { "contains": "slop-is-law" } } } },
    { "n": 3, "alice": { "exec": "sv_gravity 400; mp_friendlyfire 1; mp_roundtime 90; mp_freezetime 0; mp_respawntime 2; sv_cheats 0" } },
    { "n": 3, "alice": { "exec": "rcon mp_c4timer 30; rcon mp_round_restart_delay 3; rcon sv_maxunlag 0.2; rcon sv_showimpacts 0; rcon weapon_spread 1; rcon mp_respawn" } },
    { "expect": {
      "world": { "cvar.sv_gravity": "400", "cvar.mp_friendlyfire": "1", "cvar.mp_roundtime": "90", "cvar.mp_freezetime": "0",
        "cvar.mp_respawntime": "2", "cvar.sv_cheats": "0", "cvar.mp_c4timer": "30", "cvar.mp_round_restart_delay": "3",
        "cvar.sv_maxunlag": "0.2", "cvar.sv_showimpacts": "0", "cvar.weapon_spread": "1" },
      "alice": { "consoleText": { "contains": "\"mp_respawn\" = \"auto\"" } } } },
    { "n": 3, "alice": { "exec": "admin_logout" } },
    { "expect": { "alice": { "consoleText": { "contains": "admin" } } } }
  ]
}
