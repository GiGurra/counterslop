  { "n": 60, "alice": { "f": 1, "r": 1 } },
  { "expect": { "alice": { "pos": [{ "min": -11.5, "max": -6 }, -0.5, null] } } },
  { "n": 2, "alice": { "f": 0, "r": 0 }, "bob": { "tap": ["jump"] } },
  { "n": 60 },
  { "expect": { "bob": { "ride": null, "onGround": false, "pos": [null, { "min": -3, "max": 0.5 }, null] }, "alice": { "ride": 1 } } },
  { "n": 2, "alice": { "tap": ["use"] } },
  { "n": 30 },
  { "expect": { "alice": { "ride": null, "onGround": false } } }
 ]
