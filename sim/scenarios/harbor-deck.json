{
  "description": "Standing on and sitting in lab_harbor's dinghy, with the HUD's boat badge (game/boatseat.js): alice on the quay next to the moored boat sees 'E sit down'; she walks off the edge, lands on the boat's floor and stands on its deck ('STANDING ROOM ONLY'), then walks forward to the bow; bob walks off the quay onto the boat's stern and E sits him at the free tiller ('DRIVER', the keys); alice's E sits her in the bow seat ('PASSENGER · SEAT 2', the tiller taken); bob drives out; his +seat (X) moves him to the free middle seat, alice's badge offers the tiller and her +seat takes it; the prediction in sync",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel lab_harbor"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "set", "args": [{"pos": [-12, 0, 10.5], "yaw": 0, "pitch": -0.35}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-12, 0, 12], "yaw": 0, "pitch": -0.3}]},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"hud.boat.role": "near", "hud.boatText": ["has", "E sit down"]}]},
    {"snapshot": "near-a-boat", "clients": ["alice"]},

    {"client": "alice", "call": "hold", "args": [["KeyW", "ShiftLeft"]]},
    {"step": 40},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 20},
    {"client": "alice", "call": "expectState", "args": [{"me.ride": 1, "me.seat": -1, "me.onGround": true, "hud.boat.role": "deck", "hud.boatText": ["has", "STANDING ROOM ONLY"]}]},
    {"client": "alice", "call": "expectInSync"},
    {"snapshot": "on-deck", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [["KeyW", "ShiftLeft"]]},
    {"step": 25},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 20},
    {"client": "alice", "call": "expectState", "args": [{"me.ride": 1, "me.seat": -1, "me.deck.2": ["<", -0.6]}]},

    {"client": "bob", "call": "hold", "args": [["KeyW", "ShiftLeft"]]},
    {"step": 66},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"step": 20},
    {"client": "bob", "call": "expectState", "args": [{"me.ride": 1, "me.seat": -1}]},
    {"client": "bob", "call": "hold", "args": [["KeyE"]]},
    {"step": 3},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"step": 10},
    {"client": "bob", "call": "expectState", "args": [{"me.ride": 1, "me.seat": 0, "hud.boat.role": "driver", "hud.boatText": ["has", "DRIVER"]}]},
    {"snapshot": "driver", "clients": ["bob"]},
    {"client": "alice", "call": "hold", "args": [["KeyE"]]},
    {"step": 3},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"me.ride": 1, "me.seat": 2, "hud.boat.role": "passenger", "hud.boat.tiller": false, "hud.boatText": ["has", "PASSENGER · SEAT 2"]}]},
    {"snapshot": "passenger", "clients": ["alice"]},

    {"client": "bob", "call": "hold", "args": [["KeyW"]]},
    {"step": 80},
    {"client": "bob", "call": "expectInSync"},
    {"client": "bob", "call": "hold", "args": [["KeyX"]]},
    {"step": 3},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"step": 10},
    {"client": "bob", "call": "expectState", "args": [{"me.ride": 1, "me.seat": 1}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.boat.role": "passenger", "hud.boat.tiller": true, "hud.boatText": ["has", "X take the tiller"]}]},
    {"snapshot": "tiller-free", "clients": ["alice", "bob"]},
    {"client": "alice", "call": "hold", "args": [["KeyX"]]},
    {"step": 3},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"me.ride": 1, "me.seat": 0, "hud.boat.role": "driver"}]},
    {"client": "alice", "call": "expectInSync"},
    {"snapshot": "alice-drives", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
