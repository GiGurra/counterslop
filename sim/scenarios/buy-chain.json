{
  "description": "Buys chain (GitHub #1): in the buy zone during warmup, B 4 1 buys Copy-Paste and the menu goes back to the categories with 'bought Copy-Paste'; 6 2 a Merge Conflict, 5 2 the vest + helmet, 1 3 the Hotfix follow without reopening it, the money going down each time. With cl_buy_close 1 (Options -> Buy menu) the next buy (6 1) closes it, as in CS 1.6",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"client": "alice", "call": "team", "args": ["vibe"]}, {"wait": 300},
    {"wait": 300},
    {"step": 20},
    {"client": "alice", "call": "expectState", "args": [{"hud.canBuy": true}]},
    {"client": "alice", "call": "keyTap", "args": ["KeyB"]}, {"step": 3},
    {"client": "alice", "call": "keyTap", "args": ["Digit4"]}, {"step": 3},
    {"client": "alice", "call": "keyTap", "args": ["Digit1"]},
    {"step": 5}, {"wait": 100}, {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"hud.buyLine": "bought Copy-Paste"}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.buyMenu": true, "hud.buyItems": "", "hud.weapon": "Copy-Paste"}]},
    {"snapshot": "after-rifle"},
    {"client": "alice", "call": "keyTap", "args": ["Digit6"]}, {"step": 3},
    {"client": "alice", "call": "keyTap", "args": ["Digit2"]},
    {"step": 5}, {"wait": 100}, {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"hud.buyLine": "bought Merge Conflict"}]},
    {"client": "alice", "call": "keyTap", "args": ["Digit5"]}, {"step": 3},
    {"client": "alice", "call": "keyTap", "args": ["Digit2"]},
    {"step": 5}, {"wait": 100}, {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"hud.helmet": true}]},
    {"client": "alice", "call": "keyTap", "args": ["Digit1"]}, {"step": 3},
    {"client": "alice", "call": "keyTap", "args": ["Digit3"]},
    {"step": 5}, {"wait": 100}, {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"hud.buyLine": "bought Hotfix"}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.buyMenu": true, "hud.buyItems": "", "hud.armor": 100, "hud.money": 11950}]},
    {"snapshot": "chained"},
    {"client": "alice", "call": "keyTap", "args": ["Escape"]}, {"step": 3},
    {"client": "alice", "call": "exec", "args": ["cl_buy_close 1"]}, {"step": 3},
    {"client": "alice", "call": "keyTap", "args": ["KeyB"]}, {"step": 3},
    {"client": "alice", "call": "keyTap", "args": ["Digit6"]}, {"step": 3},
    {"client": "alice", "call": "keyTap", "args": ["Digit1"]},
    {"step": 5}, {"wait": 100}, {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.buyMenu": false}]},
    {"client": "alice", "call": "exec", "args": ["cl_buy_close 0"]},
    {"client": "alice", "call": "expectInSync"}
  ]
}
