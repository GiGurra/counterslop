{
  "description": "Top-down and orbit views of de_slop with two players at their spawns; then bot_quota 10 starts a 5v5 round and the freeze time shows each team in one covered yard",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"wait": 300},
    {"step": 10},
    {"client": "alice", "call": "camera", "args": ["overview"]},
    {"client": "alice", "call": "hud", "args": [false]},
    {"client": "alice", "call": "expectState", "args": [{"map": "de_slop", "team": ["!=", "spec"], "players.length": [">", 0]}]},
    {"client": "bob", "call": "expectState", "args": [{"team": ["!=", "spec"]}]},
    {"snapshot": "overview", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 0.7}]},
    {"snapshot": "orbit", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["mp_warmup_time 0; mp_respawn 0; mp_freezetime 10; bot_quota 10"]},
    {"wait": 1500},
    {"step": 60},
    {"wait": 300},
    {"client": "alice", "call": "camera", "args": ["overview"]},
    {"snapshot": "overview-5v5", "clients": ["alice"]}
  ]
}
