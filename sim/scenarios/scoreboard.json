{
  "description": "Tab scoreboard with three players",
  "clients": [
    "alice",
    "bob",
    "carol"
  ],
  "steps": [
    {
      "client": "*",
      "call": "time",
      "args": [
        40
      ]
    },
    {
      "join": true
    },
    {
      "step": 5
    },
    {
      "client": "alice",
      "call": "ui",
      "args": [
        "scoreboard"
      ]
    },
    {
      "client": "alice",
      "call": "expectState",
      "args": [
        {
          "scoreboard": true,
          "players.length": [
            ">",
            1
          ],
          "hud.tagsUnderHud": true
        }
      ]
    },
    {
      "client": "alice",
      "call": "waitState",
      "args": [
        {
          "hud.sbPings": 2
        },
        8000
      ]
    },
    {
      "snapshot": "scoreboard",
      "clients": [
        "alice"
      ]
    }
  ]
}
