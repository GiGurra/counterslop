{
  "description": "lab_harbor's dinghy (internal/sim boat.go, internal/game ride_shared.go): alice on the quay presses E and takes the tiller, bob boards as a passenger; full ahead out over the basin (the driver's view, the passenger's, and from the quay), the tiller to starboard, bob hops out into the water, alice drives on to the ship's hull and comes to rest against it; the driver's prediction in sync throughout",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel lab_harbor"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "set", "args": [{"pos": [-12.6, 0, 10.5], "yaw": 0, "pitch": -0.1}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-11.4, 0, 10.5], "yaw": 0, "pitch": -0.1}]},
    {"step": 10},
    {"client": "alice", "call": "hold", "args": [["KeyE"]]},
    {"step": 3},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 10},
    {"client": "bob", "call": "hold", "args": [["KeyE"]]},
    {"step": 3},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"me.ride": 1, "me.seat": 0}]},
    {"client": "bob", "call": "expectState", "args": [{"me.ride": 1, "me.seat": 1}]},
    {"snapshot": "boarded", "clients": ["alice", "bob"]},

    {"client": "alice", "call": "hold", "args": [["KeyW"]]},
    {"step": 90},
    {"client": "alice", "call": "expectState", "args": [{"me.ride": 1, "me.pos.2": ["<", 3]}]},
    {"client": "alice", "call": "expectInSync"},
    {"snapshot": "underway", "clients": ["alice", "bob"]},
    {"client": "bob", "call": "camera", "args": [{"eye": [-4, 3, 8], "yaw": 0.8, "pitch": -0.25}]},
    {"step": 2},
    {"snapshot": "from-the-quay", "clients": ["bob"]},
    {"client": "bob", "call": "camera", "args": [null]},

    {"client": "alice", "call": "hold", "args": [["KeyW", "KeyD"]]},
    {"step": 40},
    {"client": "alice", "call": "expectInSync"},
    {"snapshot": "turning", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [["KeyW"]]},
    {"client": "bob", "call": "hold", "args": [["Space"]]},
    {"step": 3},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"step": 60},
    {"client": "bob", "call": "expectState", "args": [{"me.ride": 0, "me.onGround": false}]},
    {"client": "bob", "call": "expectInSync"},
    {"snapshot": "bob-overboard", "clients": ["bob"]},

    {"client": "alice", "call": "hold", "args": [["KeyW", "KeyA"]]},
    {"step": 30},
    {"client": "alice", "call": "hold", "args": [["KeyW"]]},
    {"step": 300},
    {"client": "alice", "call": "expectState", "args": [{"me.ride": 1, "me.pos.2": ["<", -27]}]},
    {"client": "alice", "call": "expectInSync"},
    {"snapshot": "at-the-hull", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
