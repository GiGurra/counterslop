{
  "description": "Client-side recording (docs/replays.md part 4; off by default, alice opts in with cl_autorecord 1): her client records the round she plays from what it receives; bob kills her; her Replays screen lists it under RECORDED BY YOU (still recording); saving gives a .cstv.gz in the server's format (her id as the point of view, the kill in it); watching it follows alice in first person, and the kill is on the timeline",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "exec", "args": ["cl_autorecord 1"]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["mp_freezetime 0; mp_roundtime 3; mp_respawn 0"]},
    {"wait": 300},
    {"client": "alice", "call": "expectState", "args": [{"recordings.length": 0}]},
    {"client": "alice", "call": "exec", "args": ["mp_warmup_end"]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "live"}]},
    {"client": "alice", "call": "set", "args": [{"pos": [-20, 0, 8], "yaw": 0, "pitch": 0}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-12, 0, 8], "yaw": 1.5708, "pitch": -0.05}]},
    {"client": "bob", "call": "exec", "args": ["give linter"]},
    {"wait": 300},
    {"client": "bob", "call": "hold", "args": [[], true]},
    {"step": 80},
    {"client": "bob", "call": "hold", "args": [[], false]},
    {"wait": 600},
    {"client": "alice", "call": "expectState", "args": [{"hud.hp": 0, "recordings.length": 1, "recordings.0.round": 1, "recordings.0.live": true, "recordings.0.size": [">", 2000]}]},
    {"client": "alice", "call": "ui", "args": ["replays"]},
    {"snapshot": "recorded-by-you", "clients": ["alice"]},
    {"client": "alice", "call": "saveRecording", "args": [0]},
    {"client": "alice", "call": "expectState", "args": [{"saved.recorder": "client", "saved.round": 1, "saved.snaps": [">", 50], "saved.events": ["has", "kill"], "saved.name": ["has", "-round-01.cstv.gz"]}]},
    {"client": "alice", "call": "watchRecording", "args": [0]},
    {"step": 20},
    {"client": "alice", "call": "expectState", "args": [{"replay.observer.mode": "first", "replay.marks.length": [">", 1], "replay.observer.target": [">", 0], "replay.notes.length": 0}]},
    {"snapshot": "watching-own-recording", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["replay stop"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"screen": "menu"}]},
    {"client": "alice", "call": "exec", "args": ["cl_autorecord 0"]}
  ]
}
