{
  "description": "The in-game map editor (web/game/editor.js over the server's edit session): alice starts a blank map and flies; with the box tool (2) she clicks two corners on the floor (a box lands for everyone), raises the next one's height with the wheel and picks crate ([ ]) for a second; with the select tool (1) she clicks the first box (outline and face handles), grabs its near face and pulls it towards her (one resize op), presses R for a ramp, and Ctrl+Z undoes it. Bob (an admin too, so flying) sees each edit land, and alice's cursor and selection in her colour (editor presence)",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"wait": 300},
    {"client": "alice", "call": "exec", "args": ["map_edit new de_scenario_ui"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "set", "args": [{"pos": [0, 6, 10], "yaw": 0, "pitch": -0.9}]},
    {"client": "bob", "call": "set", "args": [{"pos": [18, 0, 12], "yaw": 1.3, "pitch": 0.05}]},
    {"step": 20},
    {"client": "alice", "call": "expectState", "args": [{"me.noclip": true, "editor.tool": "select", "editor.boxes": 1}]},
    {"snapshot": "editing", "clients": ["alice"]},

    {"client": "alice", "call": "hold", "args": [["Digit2"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]}, {"step": 2},
    {"client": "alice", "call": "hold", "args": [["Mouse0"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]}, {"step": 2},
    {"client": "alice", "call": "set", "args": [{"yaw": -0.45, "pitch": -0.75}]},
    {"step": 4},
    {"client": "alice", "call": "expectState", "args": [{"editor.tool": "box", "editor.anchor": true}]},
    {"snapshot": "box-preview", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [["Mouse0"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]},
    {"wait": 200}, {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"editor.boxes": 2}]},
    {"client": "bob", "call": "expectState", "args": [{"map": "de_scenario_ui"}]},

    {"client": "alice", "call": "hold", "args": [["MWheelUp"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]}, {"step": 1},
    {"client": "alice", "call": "hold", "args": [["MWheelUp"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]}, {"step": 1},
    {"client": "alice", "call": "hold", "args": [["BracketLeft"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]}, {"step": 1},
    {"client": "alice", "call": "set", "args": [{"yaw": 0.5, "pitch": -0.8}]}, {"step": 3},
    {"client": "alice", "call": "hold", "args": [["Mouse0"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]}, {"step": 2},
    {"client": "alice", "call": "set", "args": [{"yaw": 0.85, "pitch": -0.7}]}, {"step": 3},
    {"client": "alice", "call": "hold", "args": [["Mouse0"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]},
    {"wait": 200}, {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"editor.boxes": 3, "editor.height": 3}]},
    {"client": "bob", "call": "set", "args": [{"pos": [0, 0, 16], "yaw": 0, "pitch": -0.05}]},
    {"step": 10},
    {"snapshot": "two-boxes", "clients": ["bob"]},

    {"client": "alice", "call": "hold", "args": [["Digit1"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]},
    {"client": "alice", "call": "set", "args": [{"yaw": -0.25, "pitch": -0.85}]}, {"step": 3},
    {"client": "alice", "call": "hold", "args": [["Mouse0"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]}, {"step": 3},
    {"client": "alice", "call": "expectState", "args": [{"editor.sel.i": 1}]},
    {"client": "bob", "call": "set", "args": [{"pos": [0, 4, 14], "yaw": -0.2, "pitch": -0.5}]},
    {"wait": 300}, {"step": 10},
    {"client": "bob", "call": "expectState", "args": [{"editor.editors.0.name": "alice", "editor.editors.0.tool": "select"}]},
    {"snapshot": "selected", "clients": ["alice", "bob"]},
    {"client": "alice", "call": "hold", "args": [["Mouse0"]]}, {"step": 2},
    {"client": "alice", "call": "set", "args": [{"pitch": -1.1}]}, {"step": 3},
    {"client": "alice", "call": "expectState", "args": [{"editor.drag": "resize"}]},
    {"snapshot": "dragging", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"wait": 200}, {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"editor.sel.size.2": [">", 1.5]}]},
    {"client": "alice", "call": "hold", "args": [["KeyR"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]},
    {"wait": 200}, {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"editor.sel.ramp": 1}]},
    {"client": "alice", "call": "hold", "args": [["ControlLeft", "KeyZ"]]}, {"step": 2}, {"client": "alice", "call": "hold", "args": [[]]},
    {"wait": 200}, {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"editor.sel.ramp": 0}]},
    {"snapshot": "resized", "clients": ["alice", "bob"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
