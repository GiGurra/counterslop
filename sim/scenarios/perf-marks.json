{
  "description": "Render cost of bullet holes and casings (bench: n frames, each waited for; results in the client state's bench list): none, then the full rings (1024 holes, 512 casings, one instanced draw each) at alice's feet on de_slop, alternating; then on gs_megabyte under its lamps (lit like the floor they lie on). Headless is SwiftShader: compare within a run, never across machines",
  "realtime": true,
  "callTimeout": 240,
  "callTimeoutReason": "renderer benches on gs_megabyte under software GL (SwiftShader): ~0.6-1.7 s a 1280x720 frame on 16 cores, ~5x that on a 4-vCPU CI runner, so one bench or sprayLoad call takes up to ~2 min there; slow, not stuck",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "alice", "call": "set", "args": [{"pos": [24, 0, -22], "yaw": 1.5708, "pitch": -0.5}]},
    {"step": 10},
    {"client": "alice", "call": "debrisFill", "args": [0, 0]},
    {"client": "alice", "call": "bench", "args": [30]},
    {"client": "alice", "call": "debrisFill", "args": [1024, 512]},
    {"client": "alice", "call": "bench", "args": [30]},
    {"client": "alice", "call": "debrisFill", "args": [0, 0]},
    {"client": "alice", "call": "bench", "args": [30]},
    {"client": "alice", "call": "debrisFill", "args": [1024, 512]},
    {"client": "alice", "call": "bench", "args": [30]},
    {"client": "alice", "call": "expectState", "args": [{"bench.0.median": [">", 0], "bench.3.marks.decals": 1024, "bench.3.marks.bits": 512, "bench.3.marks.draws": 2, "bench.2.marks.draws": 0}]},
    {"snapshot": "full", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["changelevel gs_megabyte"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"wait": 400},
    {"step": 40},
    {"client": "alice", "call": "settleLights"},
    {"client": "alice", "call": "set", "args": [{"pos": [-24, 0, -19], "yaw": 0, "pitch": -0.6}]},
    {"step": 2},
    {"client": "alice", "call": "debrisFill", "args": [0, 0]},
    {"client": "alice", "call": "bench", "args": [20]},
    {"client": "alice", "call": "debrisFill", "args": [1024, 512]},
    {"client": "alice", "call": "bench", "args": [20]},
    {"client": "alice", "call": "expectState", "args": [{"bench.5.marks.draws": 2, "map": "gs_megabyte"}]},
    {"snapshot": "megabyte", "clients": ["alice"]}
  ]
}
