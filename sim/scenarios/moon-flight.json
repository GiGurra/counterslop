{
  "description": "Star Slop phase 2 on lab_moon: alice on Earth's field by the launch pad, looking east at the void, the Moon's plateau and the space sky (stars, the Moon); she steps on the pad and is thrown up and east into space (a shot mid-flight, coasting), lands on the Moon's plateau at 1/6 g, looks back west at the Earth in the sky, and jumps there (a slow, high Moon jump).",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "alice", "call": "exec", "args": ["changelevel lab_moon"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"wait": 400},
    {"client": "alice", "call": "exec", "args": ["mp_freezetime 0; mp_warmup_time 0; mp_respawn 0"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"map": "lab_moon", "round.mode": "tickets"}]},
    {"client": "alice", "call": "set", "args": [{"pos": [-34, 0, 0], "yaw": -1.5708, "pitch": 0.12}]},
    {"wait": 300},
    {"step": 30},
    {"snapshot": "earth-pad", "clients": ["alice"]},
    {"client": "alice", "call": "set", "args": [{"pos": [-26, 0.1, 0], "yaw": -1.5708, "pitch": 0.1}]},
    {"wait": 100},
    {"step": 210},
    {"client": "alice", "call": "expectState", "args": [{"me.onGround": false, "me.pos.0": ["~", [6, 14]]}]},
    {"snapshot": "in-space", "clients": ["alice"]},
    {"step": 420},
    {"wait": 300},
    {"step": 30},
    {"client": "alice", "call": "expectState", "args": [{"me.onGround": true, "me.pos.0": ["~", [85, 3]], "me.pos.1": ["~", [20, 0.1]]}]},
    {"client": "alice", "call": "set", "args": [{"yaw": 1.5708, "pitch": 0.3}]},
    {"wait": 200},
    {"step": 10},
    {"snapshot": "earth-from-the-moon", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [["Space"]]},
    {"step": 3},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 67},
    {"client": "alice", "call": "expectState", "args": [{"me.onGround": false, "me.pos.1": ["~", [22, 0.8]]}]},
    {"snapshot": "moon-jump", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
