{
  "description": "Moving solids over an unreliable transport: alice rides gs_megabyte's west up escalator and walks on it with 20% loss, 10% duplicates and 80 ms reordering on commands and snapshots, and 20 commands in a row lost outright; once the faults stop, client and server agree exactly while she is still riding (the replays run the treads on the same command clock)",
  "realtime": true,
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"wait": 300},
    {"client": "alice", "call": "exec", "args": ["changelevel gs_megabyte"]},
    {"wait": 600},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"wait": 400},
    {"client": "alice", "call": "set", "args": [{"pos": [-20.4, 0, -6.5], "yaw": 3.1416, "pitch": 0}]},
    {"wait": 300},
    {"step": 30},
    {"client": "alice", "call": "cvar", "args": ["net_fakeloss", 0.2]},
    {"client": "alice", "call": "cvar", "args": ["net_fakedup", 0.1]},
    {"client": "alice", "call": "cvar", "args": ["net_fakereorder", 80]},
    {"client": "alice", "call": "hold", "args": [["KeyW", "ShiftLeft"], true]},
    {"step": 60},
    {"wait": 150},
    {"client": "alice", "call": "hold", "args": [[], false]},
    {"step": 80},
    {"wait": 150},
    {"client": "alice", "call": "dropCmds", "args": [20]},
    {"step": 40},
    {"wait": 150},
    {"client": "alice", "call": "keyTap", "args": ["Space"]},
    {"step": 60},
    {"wait": 150},
    {"client": "alice", "call": "cvar", "args": ["net_fakeloss", 0]},
    {"client": "alice", "call": "cvar", "args": ["net_fakedup", 0]},
    {"client": "alice", "call": "cvar", "args": ["net_fakereorder", 0]},
    {"step": 10},
    {"wait": 500},
    {"step": 2},
    {"wait": 300},
    {"client": "alice", "call": "expectState", "args": [{"me.onGround": true, "me.pos.1": [">", 1], "me.pos.2": ["<", 3.5]}]},
    {"client": "alice", "call": "expectInSync"},
    {"snapshot": "converged-riding"},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
