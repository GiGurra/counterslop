{
  "description": "Scope behaviour: Linter (hold mode) stays zoomed while firing; Code Review (toggle mode, the default) unzooms during the bolt and re-zooms by itself",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"wait": 300},
    {"client": "alice", "call": "set", "args": [{"pos": [-20, 0, 8], "yaw": -1.5708, "pitch": 0}]},
    {"client": "alice", "call": "cvar", "args": ["zoom_mode", "hold"]},
    {"client": "alice", "call": "exec", "args": ["give linter"]},
    {"wait": 300},
    {"step": 30},
    {"client": "alice", "call": "hold", "args": [[], false, true]},
    {"step": 2},
    {"snapshot": "linter-zoomed"},
    {"client": "alice", "call": "hold", "args": [[], true, true]},
    {"step": 15},
    {"snapshot": "linter-firing-still-zoomed"},
    {"client": "alice", "call": "hold", "args": [[], false, false]},
    {"client": "alice", "call": "cvar", "args": ["zoom_mode", "toggle"]},
    {"client": "alice", "call": "exec", "args": ["give codereview"]},
    {"wait": 300},
    {"step": 30},
    {"client": "alice", "call": "mouseClick", "args": [1]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"scoped": false}]},
    {"client": "alice", "call": "mouseClick", "args": [2]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"scoped": true}]},
    {"snapshot": "review-zoomed"},
    {"client": "alice", "call": "hold", "args": [[], true]},
    {"step": 1},
    {"client": "alice", "call": "hold", "args": [[], false]},
    {"step": 30},
    {"snapshot": "review-bolt-cycling"},
    {"step": 50},
    {"snapshot": "review-rezoomed"}
  ]
}
