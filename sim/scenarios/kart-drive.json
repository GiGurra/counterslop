{
  "description": "lab_kart's cars (internal/sim car.go, internal/game cars.go, docs/racing.md): the grid with one car of each type; alice presses E by the Intern Buggy and drives it east (the chase camera with the HUD's speedometer and car HP, then first person from the seat), bob takes the Legacy Tank and pivots it on the spot; both predicted in sync",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel lab_kart"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "camera", "args": [{"eye": [-40, 12, 34], "yaw": -1.2, "pitch": -0.45}]},
    {"client": "alice", "call": "hud", "args": [false]},
    {"step": 2},
    {"snapshot": "grid", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},
    {"client": "alice", "call": "hud", "args": [true]},
    {"client": "alice", "call": "set", "args": [{"pos": [-60, 0, 22], "yaw": -1.5708, "pitch": -0.1}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-60, 0, 40.2], "yaw": -1.5708, "pitch": -0.1}]},
    {"step": 10},
    {"client": "alice", "call": "hold", "args": [["KeyE"]]},
    {"client": "bob", "call": "hold", "args": [["KeyE"]]},
    {"step": 3},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"me.car": 1}]},
    {"client": "bob", "call": "expectState", "args": [{"me.car": 3}]},
    {"snapshot": "in-the-buggy", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [["KeyW"]]},
    {"client": "bob", "call": "hold", "args": [["KeyD"]]},
    {"step": 120},
    {"client": "alice", "call": "expectInSync"},
    {"client": "bob", "call": "expectInSync"},
    {"snapshot": "chase", "clients": ["alice", "bob"]},
    {"client": "alice", "call": "exec", "args": ["cl_carcam 0"]},
    {"step": 20},
    {"snapshot": "first-person", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["cl_carcam 1"]},
    {"client": "alice", "call": "hold", "args": [["KeyW", "KeyA"]]},
    {"step": 60},
    {"client": "alice", "call": "expectInSync"},
    {"snapshot": "turning", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"client": "bob", "call": "hold", "args": [[]]}
  ]
}
