{
  "description": "de_standup: top-down overview, an orbit view and a look from each side's spawn (changelevel from the console)",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_standup"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "expectState", "args": [{"map": "de_standup", "team": "vibe", "screen": "playing"}]},
    {"client": "bob", "call": "expectState", "args": [{"map": "de_standup", "team": "artisan"}]},
    {"snapshot": "spawn"},
    {"client": "alice", "call": "camera", "args": ["overview"]},
    {"snapshot": "overview", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 0.7}]},
    {"snapshot": "orbit", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 3.8}]},
    {"snapshot": "orbit2", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
