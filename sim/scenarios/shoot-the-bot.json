{
  "description": "A frozen target-practice bot: hitboxes shown, a head shot and a body shot with server hit feedback",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"client": "alice", "call": "exec", "args": ["bot_kick"]},
    {"client": "alice", "call": "exec", "args": ["bot_add"]},
    {"wait": 300},
    {"client": "alice", "call": "exec", "args": ["bot_freeze 1"]},
    {"client": "alice", "call": "exec", "args": ["rcon weapon_spread 0"]},
    {"wait": 200},
    {"client": "alice", "call": "aimAtBot", "args": ["head", 8]},
    {"client": "alice", "call": "cvar", "args": ["cl_showhitboxes", 1]},
    {"wait": 300},
    {"step": 5},
    {"snapshot": "hitboxes"},
    {"client": "alice", "call": "hold", "args": [[], true]},
    {"step": 1},
    {"client": "alice", "call": "hold", "args": [[], false]},
    {"wait": 200},
    {"step": 12},
    {"client": "alice", "call": "expectState", "args": [{"lastHit.part": "head"}]},
    {"snapshot": "headshot"},
    {"client": "alice", "call": "aimAtBot", "args": ["body", 8]},
    {"wait": 200},
    {"step": 10},
    {"client": "alice", "call": "hold", "args": [[], true]},
    {"step": 1},
    {"client": "alice", "call": "hold", "args": [[], false]},
    {"wait": 200},
    {"step": 12},
    {"client": "alice", "call": "expectState", "args": [{"lastHit.part": "body"}]},
    {"snapshot": "bodyshot"},
    {"client": "alice", "call": "camera", "args": [{"orbit": 2.2, "radius": 14, "height": 6}]},
    {"client": "alice", "call": "exec", "args": ["bot_freeze 0"]},
    {"wait": 1500},
    {"step": 5},
    {"snapshot": "wandering"},
    {"client": "alice", "call": "exec", "args": ["rcon weapon_spread 1"]},
    {"client": "alice", "call": "exec", "args": ["bot_kick"]}
  ]
}
