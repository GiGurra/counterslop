{
  "description": "No Big Diff countdown (GitHub #13): alice force-pushes it at B; the top bar then shows PLANTED · SITE B and a light flashing with the beeps, no seconds and no round timer (mp_c4_show_timer 0, the default); the slab's CI bar stays empty. rcon mp_c4_show_timer 1 (Server settings) brings back the seconds and the bar",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["mp_freezetime 3"]},
    {"client": "alice", "call": "exec", "args": ["mp_c4timer 60"]},
    {"client": "alice", "call": "exec", "args": ["mp_warmup_time 0; mp_respawn 0"]},
    {"wait": 300},
    {"step": 5},
    {"wait": 3200},
    {"client": "alice", "call": "set", "args": [{"pos": [8, 0, -24], "yaw": 3.1416, "pitch": -0.45}]},
    {"client": "bob", "call": "set", "args": [{"pos": [26, 0, 0], "yaw": 1.57}]},
    {"wait": 300},
    {"step": 20},
    {"client": "alice", "call": "keyTap", "args": ["Digit5"]},
    {"step": 60},
    {"client": "alice", "call": "hold", "args": [[], true]},
    {"step": 200},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"client": "alice", "call": "set", "args": [{"pos": [11, 0, -21], "yaw": 0.785, "pitch": -0.35}]},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "planted"}]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.ciBadge": "PLANTED · SITE B"}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.topMid": ["lacks", ":"]}]},
    {"snapshot": "planted-no-countdown", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["mp_c4_show_timer 1"]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.ciBadge": ["has", "PLANTED · SITE B"]}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.ciBadge": ["has", "s"]}]},
    {"snapshot": "planted-countdown", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["mp_c4_show_timer 0"]}
  ]
}
