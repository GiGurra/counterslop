{
  "description": "gs_megabyte's escalator landings, where the treads run level with the floor: at the foot and the head of both pairs, close and at a grazing angle from afar, at two phases of the treads; the drawn treads sit a centimetre into the floor, so nothing flickers (TestMoversNoZFighting pins the geometry)",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "alice", "call": "exec", "args": ["changelevel gs_megabyte"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"wait": 400},
    {"step": 10},
    {"draw": true, "clients": ["alice"]},
    {"client": "alice", "call": "expectState", "args": [{"map": "gs_megabyte", "screen": "playing", "gfx.beltSteps": [">", 60]}]},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-19.65, 1.2, -9], "yaw": 3.1416, "pitch": -0.25}]},
    {"step": 2},
    {"snapshot": "west-foot", "clients": ["alice"]},
    {"step": 17},
    {"snapshot": "west-foot-later", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-19.65, 0.5, -24], "yaw": 3.1416, "pitch": -0.03}]},
    {"step": 2},
    {"snapshot": "west-foot-far", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-19.65, 6.2, 7], "yaw": 0, "pitch": -0.35}]},
    {"step": 2},
    {"snapshot": "west-head", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [19.65, 1.2, 8], "yaw": 0, "pitch": -0.25}]},
    {"step": 2},
    {"snapshot": "east-foot", "clients": ["alice"]},
    {"step": 17},
    {"snapshot": "east-foot-later", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [19.65, 0.5, 23], "yaw": 0, "pitch": -0.03}]},
    {"step": 2},
    {"snapshot": "east-foot-far", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [19.65, 6.2, -8], "yaw": 3.1416, "pitch": -0.35}]},
    {"step": 2},
    {"snapshot": "east-head", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
