{
  "description": "Team limit (mp_limitteams) reaches the team menu through the snapshots: alice plays for the Vibe Coders; with the default limit 1 bob's menu shows them FULL and says the limit (and, bob being admin on the test server, how to lift it); after mp_limitteams 0 the card opens and bob joins the bigger side by clicking it; back at 1 carol's menu shows it FULL again (2 bigger would be 3); in Server settings, Auto team balance Off with Team limit 1 warns that the join limit is separate",
  "clients": ["alice", "bob", "carol"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "spec"]},
    {"wait": 200},
    {"step": 2},
    {"client": "bob", "call": "ui", "args": ["teammenu"]},
    {"step": 2},
    {"client": "bob", "call": "expectState", "args": [{"teamLimit": 1, "teamMenu": true, "teamCards": "full: FULL: would be 2 bigger (Team limit 1)lift it: Server settings, Team limit 0 | open"}]},
    {"snapshot": "limit-1-full", "clients": ["bob"]},
    {"client": "alice", "call": "exec", "args": ["rcon mp_limitteams 0"]},
    {"wait": 200},
    {"step": 4},
    {"client": "bob", "call": "expectState", "args": [{"teamLimit": 0, "teamCards": "open | open"}]},
    {"snapshot": "limit-0-open", "clients": ["bob"]},
    {"clickOn": ".team-cards .team-card:nth-child(1)", "client": "bob"},
    {"wait": 200},
    {"step": 4},
    {"client": "bob", "call": "expectState", "args": [{"team": "vibe"}]},
    {"client": "alice", "call": "exec", "args": ["rcon mp_limitteams 1"]},
    {"client": "carol", "call": "join", "args": ["carol", "spec"]},
    {"wait": 200},
    {"step": 4},
    {"client": "carol", "call": "ui", "args": ["teammenu"]},
    {"step": 2},
    {"client": "carol", "call": "expectState", "args": [{"teamLimit": 1, "teamCards": ["has", "FULL: would be 3 bigger (Team limit 1)"]}]},
    {"snapshot": "limit-1-full-again", "clients": ["carol"]},
    {"client": "alice", "call": "exec", "args": ["rcon mp_autoteambalance 0"]},
    {"wait": 200},
    {"step": 2},
    {"client": "alice", "call": "ui", "args": ["server"]},
    {"step": 2},
    {"snapshot": "settings-balance-off-limit-1", "clients": ["alice"]}
  ]
}
