{
  "description": "Grenade throws, CS-style: alice (left), bob and carol stand side by side and throw a Smoke Test level at once: alice holds attack (the full throw), bob attack + attack2 (medium), carol attack2 (the underhand lob); the pin comes out on press (the grenade drawn back; low for the lob: alice and carol held), the throw on release. A side camera follows the arcs (0.3, 0.6, 1.0 s after the release) and then the three clouds where they settled",
  "clients": ["alice", "bob", "carol"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "carol", "call": "join", "args": ["carol", "vibe"]},
    {"wait": 400},
    {"step": 10},
    {"client": "*", "call": "exec", "args": ["give smoketest; slot4"]},
    {"wait": 300},
    {"step": 10},
    {"client": "alice", "call": "set", "args": [{"pos": [-26, 0, 12], "yaw": 0, "pitch": 0}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-24, 0, 12], "yaw": 0, "pitch": 0}]},
    {"client": "carol", "call": "set", "args": [{"pos": [-22, 0, 12], "yaw": 0, "pitch": 0}]},
    {"wait": 300},
    {"step": 60},
    {"client": "alice", "call": "expectState", "args": [{"hud.weapon": "Smoke Test"}]},
    {"client": "alice", "call": "hold", "args": [[], true, false]},
    {"client": "bob", "call": "hold", "args": [[], true, true]},
    {"client": "carol", "call": "hold", "args": [[], false, true]},
    {"step": 30},
    {"client": "carol", "call": "expectState", "args": [{"hud.weapon": "Smoke Test"}]},
    {"snapshot": "pin-pulled", "clients": ["alice", "carol"]},
    {"client": "*", "call": "hold", "args": [[], false, false]},
    {"step": 1},
    {"wait": 200},
    {"client": "alice", "call": "camera", "args": [{"eye": [-6, 3.5, -4], "yaw": 1.5708, "pitch": -0.12}]},
    {"step": 30},
    {"snapshot": "arcs-0.3s", "clients": ["alice"]},
    {"step": 30},
    {"snapshot": "arcs-0.6s", "clients": ["alice"]},
    {"step": 40},
    {"snapshot": "arcs-1.0s", "clients": ["alice"]},
    {"step": 400},
    {"wait": 300},
    {"snapshot": "clouds", "clients": ["alice"]}
  ]
}
