{
  "description": "Bandwidth: four players moving and firing for 6 s of game time (lockstep, the live loop on the virtual clock); server/net in the JSON has KB/s per client over game time",
  "clients": ["alice", "bob", "carol", "dave"],
  "steps": [
    {"join": true},
    {"client": "*", "call": "hold", "args": [["KeyW", "KeyA"], true]},
    {"client": "*", "call": "live", "args": [6000]},
    {"client": "*", "call": "hold", "args": [[]]},
    {"client": "alice", "call": "expectState", "args": [{"hud.connected": true, "net.dropped": 0, "net.backlog": ["<", 30], "players.length": [">", 2]}]},
    {"snapshot": "load", "clients": ["alice"]}
  ]
}
