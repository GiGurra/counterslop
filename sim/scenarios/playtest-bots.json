{
  "description": "Playtest (not in smoke: ~1 min): alice plays a real-settings match with bot_quota 6 on de_slop: freeze, buy (Prompt + hoodie), rounds with bots fighting, the HUD, radar, kill feed and money over a minute",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"wait": 300},
    {"client": "alice", "call": "exec", "args": ["rcon changelevel de_slop"]},
    {"wait": 800},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "alice", "call": "exec", "args": ["mp_respawn 0; mp_freezetime 4; mp_round_restart_delay 3; bot_difficulty 1; bot_quota 6"]},
    {"wait": 2500},
    {"step": 10},
    {"snapshot": "freeze"},
    {"client": "alice", "call": "keyTap", "args": ["KeyB"]},
    {"step": 3},
    {"client": "alice", "call": "keyTap", "args": ["Digit3"]},
    {"step": 2},
    {"client": "alice", "call": "keyTap", "args": ["Digit2"]},
    {"step": 2},
    {"client": "alice", "call": "keyTap", "args": ["Digit5"]},
    {"step": 2},
    {"snapshot": "buying"},
    {"client": "alice", "call": "keyTap", "args": ["Digit1"]},
    {"step": 2},
    {"client": "alice", "call": "keyTap", "args": ["Escape"]},
    {"wait": 6000}, {"step": 10},
    {"snapshot": "round-live"},
    {"wait": 15000}, {"step": 10},
    {"snapshot": "later-1"},
    {"wait": 20000}, {"step": 10},
    {"client": "alice", "call": "hold", "args": [["Tab"], false]},
    {"step": 5},
    {"snapshot": "scoreboard"},
    {"client": "alice", "call": "hold", "args": [[], false]},
    {"wait": 15000}, {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"hud.connected": true}]},
    {"snapshot": "later-2"},
    {"client": "alice", "call": "exec", "args": ["bot_kick; mp_respawn 1; mp_freezetime 6; mp_round_restart_delay 5"]},
    {"wait": 500}
  ]
}
