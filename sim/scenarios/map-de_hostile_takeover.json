{
  "description": "de_hostile_takeover: each side's spawn (the startup's quay, the ship's midships), an overview and orbit, the loading pier's ramp and the gangway into A, site B under the bridge, up the accommodation ladder from its pontoon; then the hostile part: alice (in the Gravity Override) takes a dinghy across the basin to the hull, comes to rest against it and hooks it from the seat, ending on the hull's side (changelevel from the console)",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_hostile_takeover"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "expectState", "args": [{"map": "de_hostile_takeover", "team": "vibe", "screen": "playing"}]},
    {"client": "bob", "call": "expectState", "args": [{"map": "de_hostile_takeover", "team": "artisan"}]},
    {"snapshot": "spawn"},
    {"client": "alice", "call": "camera", "args": ["overview"]},
    {"snapshot": "overview", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 0.7}]},
    {"snapshot": "orbit", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},
    {"client": "bob", "call": "set", "args": [{"pos": [-49, 0, 13], "yaw": 0, "pitch": 0.1}]},
    {"step": 20},
    {"snapshot": "the-pier", "clients": ["bob"]},
    {"client": "bob", "call": "set", "args": [{"pos": [-44, 8, -12], "yaw": -1.3, "pitch": 0}]},
    {"step": 20},
    {"snapshot": "gangway-into-a", "clients": ["bob"]},
    {"client": "bob", "call": "set", "args": [{"pos": [8, 8, -13], "yaw": -1.9, "pitch": -0.05}]},
    {"step": 20},
    {"snapshot": "site-b", "clients": ["bob"]},

    {"client": "alice", "call": "set", "args": [{"boots": true}]},
    {"client": "alice", "call": "set", "args": [{"pos": [-14, 0, 10.5], "yaw": 0, "pitch": 0.6}]},
    {"step": 10},
    {"client": "alice", "call": "hold", "args": [["KeyE"]]},
    {"step": 3},
    {"client": "alice", "call": "hold", "args": [["KeyW"]]},
    {"step": 150},
    {"client": "alice", "call": "expectState", "args": [{"me.ride": 2}]},
    {"client": "alice", "call": "expectInSync"},
    {"snapshot": "crossing", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 120},
    {"client": "alice", "call": "expectState", "args": [{"me.ride": 2, "me.pos.2": [">", -9]}]},
    {"snapshot": "at-the-hull", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [["KeyF"]]},
    {"step": 120},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 20},
    {"client": "alice", "call": "expectState", "args": [{"me.ride": 0, "me.grav": 4}]},
    {"client": "alice", "call": "expectInSync"},
    {"snapshot": "on-the-hull", "clients": ["alice"]},
    {"client": "bob", "call": "set", "args": [{"pos": [0, 0, -8.8], "yaw": -1.5708, "pitch": 0.1}]},
    {"client": "bob", "call": "hold", "args": [["KeyW"]]},
    {"step": 180},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"step": 10},
    {"client": "bob", "call": "expectState", "args": [{"me.pos.1": [">", 7.9], "me.pos.0": [">", 17]}]},
    {"snapshot": "up-the-ladder", "clients": ["bob"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
