{
  "description": "Race power-ups on rc_ci_pipeline (internal/game pickups.go, web/game/pickups.js): once the race is on, every pickup floats over the road as a glowing crystal in its kind's colour over a ring; close-ups of the start straight's Bonus Approved, the jump's (in the air over the gap), the narrow bridge's Code Freeze and the flyover's Feature Flag",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [12]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel rc_ci_pipeline"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"client": "alice", "call": "exec", "args": ["mp_warmup_time 0; mp_round_restart_delay 30; mp_race_laps 1; mp_respawn 0"]},
    {"wait": 400},
    {"step": 20},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "freeze"}]},
    {"client": "alice", "call": "expectState", "args": [{"map": "rc_ci_pipeline", "round.mode": "race", "round.pu.0.k": "bonus", "round.pu.0.up": true, "round.pu.1.k": "bonus", "round.pu.2.k": "freeze", "round.pu.3.k": "flag", "round.pu.6.k": "caffeine"}]},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-30, 3, 7], "yaw": 1.2, "pitch": -0.2}]},
    {"step": 2},
    {"snapshot": "start-bonus", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-74, 6, 58], "yaw": 0.9, "pitch": -0.2}]},
    {"step": 2},
    {"snapshot": "jump-bonus", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-30, 4, 93], "yaw": 1.0, "pitch": -0.25}]},
    {"step": 2},
    {"snapshot": "bridge-freeze", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [8, 10, 10], "yaw": 0.75, "pitch": -0.3}]},
    {"step": 2},
    {"snapshot": "flyover-flag", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
