{
  "description": "Music follows the round phase: the warmup loop, Options → Audio's Music checkbox and volume slider (off: no loop), the buy-time elevator loop in freeze, silence once the round goes live (matched as round.ph containing ive, since the bare word marks a realtime scenario), the round-lost stinger when time runs out, and the buy loop again next freeze (headless Chrome schedules nothing audible; this checks the music state)",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["mp_warmup_time 600; mp_respawn 0; mp_freezetime 3; mp_roundtime 2; mp_round_restart_delay 4"]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "warmup", "music.loop": "warmup", "music.on": true}]},
    {"client": "alice", "call": "ui", "args": ["options"]},
    {"client": "alice", "call": "uiField", "args": [".music-volume", "0.25"]},
    {"client": "alice", "call": "uiField", "args": [".music-toggle", "0"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"settings.cl_music": 0, "settings.music_volume": 0.25, "music.on": false, "music.loop": null, "music.want": "warmup"}]},
    {"snapshot": "options-music-off", "clients": ["alice"]},
    {"client": "alice", "call": "uiField", "args": [".music-toggle", "1"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"settings.cl_music": 1, "music.on": true, "music.loop": "warmup"}]},
    {"client": "alice", "call": "ui", "args": ["play"]},
    {"client": "alice", "call": "exec", "args": ["mp_warmup_end"]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "freeze", "music.loop": "buytime"}, 5000]},
    {"client": "bob", "call": "waitState", "args": [{"round.ph": "freeze", "music.loop": "buytime"}, 5000]},
    {"snapshot": "freeze-buytime", "clients": ["alice"]},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": ["has", "ive"]}, 8000]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"round.ph": ["has", "ive"], "music.loop": null, "music.want": null}]},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "over", "roundWin": "artisan"}, 10000]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"music.last": "roundLost"}]},
    {"client": "bob", "call": "expectState", "args": [{"music.last": "roundWon"}]},
    {"client": "alice", "call": "exec", "args": ["mp_freezetime 60"]},
    {"wait": 4500},
    {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "freeze", "round.n": 2, "music.loop": "buytime"}, 10000]}
  ]
}
