{
  "description": "The garage at any time and the pit stop (internal/game pitstop.go, docs/racing.md \"The garage\") on lab_race: on the grid the HUD says to press B for the garage (and B / H garage by the HP); GO, alice drives over the line; mid-race B opens the garage from the track: PIT STOP, her car gone from the track, the race clock running; she buys the Senior Racecar there and leaves with H: back on the start line's spot (her last gate) in the racecar, behind bob, who drove on; then the garage again: the buggy (owned, free) back, DRIVE THIS",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel lab_race"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"client": "alice", "call": "exec", "args": ["mp_warmup_time 0; mp_round_restart_delay 30; mp_race_laps 2; mp_race_races 1; mp_respawn 0; mp_startmoney 4000"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "freeze"}]},
    {"step": 30},
    {"client": "alice", "call": "expectState", "args": [{"hud.garageCall": "press B for the garage: buy and change your car", "hud.garageHint": "B / H garage", "hud.money": 4000}]},
    {"snapshot": "grid-hint", "clients": ["alice"]},
    {"step": 290},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "live"}]},
    {"client": "alice", "call": "hold", "args": [["KeyW"]]},
    {"client": "bob", "call": "hold", "args": [["KeyW"]]},
    {"step": 100},
    {"client": "alice", "call": "expectState", "args": [{"hud.garageHint": "B / H garage", "hud.garageCall": ""}]},
    {"snapshot": "racing", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"client": "alice", "call": "keyTap", "args": ["KeyB"]},
    {"step": 1},
    {"wait": 100},
    {"step": 30},
    {"client": "alice", "call": "expectState", "args": [{"hud.garage": true, "hud.pit": true, "hud.pitBanner": ["has", "PIT STOP"]}]},
    {"client": "alice", "call": "exec", "args": ["buy car:racecar"]},
    {"wait": 200},
    {"step": 1},
    {"draw": true},
    {"step": 90},
    {"client": "alice", "call": "expectState", "args": [{"hud.garageCar": "T2 Senior Racecar", "hud.money": 1500}]},
    {"snapshot": "pit-stop", "clients": ["alice"]},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"client": "alice", "call": "keyTap", "args": ["KeyH"]},
    {"step": 1},
    {"wait": 100},
    {"step": 20},
    {"client": "alice", "call": "expectState", "args": [{"hud.garage": false, "hud.pit": false, "cars.1.k": "racecar"}]},
    {"snapshot": "back-on-track", "clients": ["alice"]},
    {"client": "alice", "call": "keyTap", "args": ["KeyB"]},
    {"step": 1},
    {"wait": 100},
    {"step": 20},
    {"client": "alice", "call": "keyTap", "args": ["ArrowLeft"]},
    {"step": 1},
    {"draw": true},
    {"step": 90},
    {"client": "alice", "call": "expectState", "args": [{"hud.garage": true, "hud.garageCar": "T1 Intern Buggy"}]},
    {"snapshot": "drive-this", "clients": ["alice"]},
    {"client": "alice", "call": "clickEl", "args": [".g-drive"]},
    {"wait": 200},
    {"step": 20},
    {"client": "alice", "call": "keyTap", "args": ["KeyH"]},
    {"step": 1},
    {"wait": 100},
    {"step": 20},
    {"client": "alice", "call": "expectState", "args": [{"hud.garage": false, "hud.money": 1500, "hud.pit": false, "cars.1.k": "buggy"}]}
  ]
}
