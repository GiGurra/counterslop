{
  "description": "Rounds + The Big Diff: code freeze, alice draws The Big Diff (5) and force-pushes it at B (holding fire) (progress bar, CI timer), bob git-reverts it (Artisans win), then next round it merges (shockwave, Vibe Coders win)",
  "clients": ["alice", "bob", "carol"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "carol", "call": "join", "args": ["carol", "vibe"]},
    {"client": "alice", "call": "exec", "args": ["mp_freezetime 3"]},
    {"client": "alice", "call": "exec", "args": ["mp_c4timer 120"]},
    {"client": "alice", "call": "exec", "args": ["mp_round_restart_delay 6"]},
    {"client": "alice", "call": "exec", "args": ["mp_warmup_time 0; mp_respawn 0"]},
    {"wait": 300},
    {"step": 5},
    {"snapshot": "freeze", "clients": ["alice"]},
    {"wait": 3200},
    {"client": "alice", "call": "set", "args": [{"pos": [8, 0, -24], "yaw": 3.1416, "pitch": -0.45}]},
    {"client": "bob", "call": "set", "args": [{"pos": [8, 0, -29], "yaw": 3.1416, "pitch": -0.25}]},
    {"client": "carol", "call": "set", "args": [{"pos": [-6, 0, -12], "yaw": 2.3, "pitch": -0.1}]},
    {"wait": 300},
    {"step": 20},
    {"snapshot": "carrier-in-site", "clients": ["alice"]},
    {"client": "alice", "call": "keyTap", "args": ["Digit5"]},
    {"step": 30},
    {"snapshot": "bigdiff-drawn", "clients": ["alice"]},
    {"step": 30},
    {"client": "alice", "call": "hold", "args": [[], true]},
    {"step": 110},
    {"wait": 150},
    {"step": 2},
    {"snapshot": "force-pushing", "clients": ["alice"]},
    {"step": 90},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"client": "alice", "call": "set", "args": [{"pos": [11, 0, -21], "yaw": 0.785, "pitch": -0.35}]},
    {"wait": 300},
    {"step": 5},
    {"snapshot": "planted", "clients": ["alice", "bob"]},
    {"client": "bob", "call": "set", "args": [{"pos": [8, 0, -25.4], "yaw": 3.1416, "pitch": -0.75}]},
    {"wait": 200},
    {"step": 10},
    {"client": "bob", "call": "hold", "args": [["KeyE"]]},
    {"step": 250},
    {"wait": 150},
    {"step": 2},
    {"snapshot": "reverting", "clients": ["bob"]},
    {"step": 240},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"wait": 100},
    {"step": 3},
    {"snapshot": "reverted", "clients": ["bob", "alice"]},
    {"client": "bob", "call": "waitState", "args": [{"score.artisan": 1, "score.vibe": 0}]},
    {"client": "alice", "call": "exec", "args": ["mp_c4timer 8"]},
    {"wait": 6000},
    {"client": "alice", "call": "set", "args": [{"pos": [8, 0, -24], "yaw": 3.1416, "pitch": -0.45}]},
    {"client": "bob", "call": "set", "args": [{"pos": [26, 0, 0], "yaw": 1.57}]},
    {"client": "carol", "call": "set", "args": [{"pos": [-2, 0, -15], "yaw": -0.83, "pitch": 0.12}]},
    {"wait": 300},
    {"step": 10},
    {"client": "alice", "call": "keyTap", "args": ["Digit5"]},
    {"step": 30},
    {"client": "alice", "call": "hold", "args": [[], true]},
    {"step": 200},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"client": "alice", "call": "set", "args": [{"pos": [-14, 0, -4], "yaw": 2.3}]},
    {"wait": 7700},
    {"step": 12},
    {"snapshot": "merged", "clients": ["carol"]},
    {"client": "carol", "call": "waitState", "args": [{"score.artisan": 1, "score.vibe": 1}]},
    {"wait": 600},
    {"step": 5},
    {"client": "carol", "call": "ui", "args": ["scoreboard"]},
    {"snapshot": "score", "clients": ["carol"]}
  ]
}
