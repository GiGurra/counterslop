{
  "description": "rc_ci_pipeline (race mode, Slop n Roll Racing): the grid from the spawn, a top-down overview of the figure eight, orbit views over the floating roads and the data sea, and a free camera on the flyover crossing the start straight (changelevel from the console)",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel rc_ci_pipeline"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "expectState", "args": [{"map": "rc_ci_pipeline", "team": "vibe", "screen": "playing"}]},
    {"client": "bob", "call": "expectState", "args": [{"map": "rc_ci_pipeline", "team": "artisan"}]},
    {"snapshot": "spawn"},
    {"client": "alice", "call": "camera", "args": ["overview"]},
    {"snapshot": "overview", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 0.7}]},
    {"snapshot": "orbit", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 3.8}]},
    {"snapshot": "orbit2", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [30, 14, 30], "yaw": 0.8, "pitch": -0.32}]},
    {"step": 2},
    {"snapshot": "flyover", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-70, 8, 20], "yaw": 2.6, "pitch": -0.25}]},
    {"step": 2},
    {"snapshot": "the-jump", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
