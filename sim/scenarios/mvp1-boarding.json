{
  "description": "Star Slop phase 3 on lab_moon: alice in Earth's spaceport terminal looking out of the window wall at MVP-1 on its pad (the departure board in the HUD); she walks through the ticket gate (the conductor: tickets please, the feed line); she and bob board while it is docked and stand in the cabin (ABOARD); the doors shut and it climbs (bob drawn standing in the cabin with her, not under its floor); a look out of the window band in flight; the floor opens over the Moon and the drop pods throw her down; she lands on the plateau and looks back at the Earth.",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel lab_moon"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"client": "alice", "call": "exec", "args": ["mp_freezetime 0; mp_warmup_time 0; mp_respawn 0"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "set", "args": [{"pos": [-126, 0, -8], "yaw": -1.25, "pitch": 0.22}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-140, 0, 10], "yaw": 0, "pitch": 0}]},
    {"wait": 200},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"map": "lab_moon", "hud.departure.name": "MVP-1"}]},
    {"snapshot": "terminal", "clients": ["alice"]},
    {"client": "alice", "call": "set", "args": [{"pos": [-113, 0, 0], "yaw": -1.5708, "pitch": 0}]},
    {"wait": 100},
    {"client": "alice", "call": "hold", "args": [["KeyW"]]},
    {"step": 30},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"wait": 300},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"feed": ["has", "Ticket scanned"]}]},
    {"snapshot": "tickets-please", "clients": ["alice"]},
    {"client": "alice", "call": "set", "args": [{"pos": [-92, 0, 1.6], "yaw": 1.5708, "pitch": -0.05}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-98, 0, -0.4], "yaw": -1.5708, "pitch": 0}]},
    {"wait": 200},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"hud.departure.aboard": true, "hud.departure.state": "boarding"}]},
    {"snapshot": "cabin", "clients": ["alice"]},
    {"step": 780},
    {"step": 180},
    {"wait": 200},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.departure.aboard": true, "me.onGround": true, "me.pos.1": ["~", [70, 40]]}]},
    {"snapshot": "climb", "clients": ["alice"]},
    {"client": "alice", "call": "set", "args": [{"yaw": 0, "pitch": -0.25}]},
    {"step": 200},
    {"wait": 200},
    {"step": 5},
    {"snapshot": "window", "clients": ["alice"]},
    {"client": "alice", "call": "set", "args": [{"yaw": 1.5708, "pitch": -1.2}]},
    {"step": 300},
    {"step": 40},
    {"wait": 200},
    {"step": 5},
    {"snapshot": "drop-pod", "clients": ["alice"]},
    {"step": 360},
    {"client": "alice", "call": "set", "args": [{"yaw": 1.5708, "pitch": 0.3}]},
    {"wait": 200},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"me.pos.1": ["~", [20, 0.1]], "me.pos.0": ["~", [90, 12]]}]},
    {"snapshot": "moon-landing", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
