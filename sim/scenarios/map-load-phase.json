{
  "description": "A map change is a load phase (internal/game maploading.go, game/loading.js): a vote to de_serverless (a nav graph built from its geometry); the server builds its nav graph (held 4 s here) while both clients load; the loading screen shows the server's step, ours and who is still loading (bob, held at his light grid), then waits for bob; when he is done the match starts on the new map. No connection-lost overlay at any point.",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"client": "alice", "call": "exec", "args": ["mp_maprotation de_serverless de_rackmount"]},
    {"wait": 200},
    {"client": "alice", "call": "exec", "args": ["mapvote 60"]},
    {"wait": 300},
    {"client": "alice", "call": "keyTap", "args": ["F1"]},
    {"client": "bob", "call": "exec", "args": ["vote 1"]},
    {"wait": 300},
    {"client": "*", "call": "expectState", "args": [{"vote.options.0": "de_serverless", "vote.votes.de_serverless": 2}]},
    {"holdNav": 400},
    {"client": "bob", "call": "holdLoad", "args": [{"step": "lights", "pct": 40}]},
    {"client": "alice", "call": "exec", "args": ["mapvote end"]},
    {"wait": 300},
    {"step": 2},
    {"client": "*", "call": "expectState", "args": [{"map": "de_serverless", "hud.loadScreen.map": "de_serverless", "hud.loadScreen.server.step": "nav", "link.mode": "ok"}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.loadScreen.me.step": "ready", "hud.loadScreen.waiting.0.name": "bob", "hud.loadScreen.waiting.0.step": "lights", "hud.loadScreen.waiting.0.pct": 40, "hud.loadScreen.status": "Waiting for the server"}]},
    {"client": "bob", "call": "expectState", "args": [{"hud.loadScreen.me.step": "lights", "hud.loadScreen.me.pct": 40, "hud.loadScreen.status": "Loading with the server…"}]},
    {"snapshot": "loading-server"},
    {"wait": 4000},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"hud.loadScreen.server.step": "ready", "hud.loadScreen.status": "Waiting for bob", "hud.loadScreen.startsIn": [">", 10], "link.mode": "ok"}]},
    {"snapshot": "loading-waiting", "clients": ["alice"]},
    {"client": "bob", "call": "holdLoad", "args": [null]},
    {"wait": 300},
    {"step": 2},
    {"client": "*", "call": "expectState", "args": [{"map": "de_serverless", "hud.loadScreen": null, "link.mode": "ok"}]},
    {"step": 3},
    {"snapshot": "playing"},
    {"client": "alice", "call": "exec", "args": ["mp_maprotation all"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
