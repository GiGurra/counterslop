{
  "description": "lab_harbor (water volumes, internal/sim water.go; boats, boat.go): the basin seen from the quay, a moored dinghy up close, bob walks off the quay and sinks (predicted in sync), the view under water (water fog, the surface from below), bob holds jump and floats up to the surface, then swims back into the quay's edge holding jump and water-jumps out onto it",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel lab_harbor"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "expectState", "args": [{"map": "lab_harbor", "team": "vibe", "screen": "playing"}]},
    {"client": "alice", "call": "set", "args": [{"pos": [-4, 0, 20], "yaw": 0.35, "pitch": -0.3}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-10, 0, 12], "yaw": 0, "pitch": 0}]},
    {"step": 10},
    {"snapshot": "basin", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-9, 1.6, 8.5], "yaw": 0.55, "pitch": -0.35}]},
    {"step": 2},
    {"snapshot": "dinghy", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},

    {"client": "bob", "call": "hold", "args": [["KeyW"]]},
    {"step": 50},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"step": 90},
    {"client": "bob", "call": "expectState", "args": [{"me.onGround": false, "me.pos.1": ["<", -2.3]}]},
    {"client": "bob", "call": "expectInSync"},
    {"snapshot": "under-water", "clients": ["bob"]},
    {"client": "bob", "call": "set", "args": [{"pitch": 0.9}]},
    {"step": 2},
    {"snapshot": "surface-from-below", "clients": ["bob"]},
    {"client": "bob", "call": "set", "args": [{"pitch": 0}]},

    {"client": "bob", "call": "hold", "args": [["Space"]]},
    {"step": 150},
    {"client": "bob", "call": "expectState", "args": [{"me.pos.1": [">", -2.3]}]},
    {"client": "bob", "call": "expectState", "args": [{"me.pos.1": ["<", -1.4]}]},
    {"client": "bob", "call": "expectInSync"},
    {"snapshot": "at-the-surface", "clients": ["bob", "alice"]},

    {"client": "bob", "call": "set", "args": [{"yaw": 3.1416}]},
    {"client": "bob", "call": "hold", "args": [["KeyW", "Space"]]},
    {"step": 200},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"step": 20},
    {"client": "bob", "call": "expectState", "args": [{"me.onGround": true, "me.pos.1": ["~", [0, 0.01]], "me.pos.2": [">", 10.2]}]},
    {"client": "bob", "call": "expectInSync"},
    {"snapshot": "back-on-the-quay", "clients": ["bob"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
