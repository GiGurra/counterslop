{
  "description": "Options: Mouse, Audio and Controls above Video; the unlocked loop's FPS cap (preset or custom). Options → Controls: one key per action with ×; binding a taken key moves it and flashes the old row; mouse/wheel binds; reset",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"client": "alice", "call": "cvar", "args": ["cl_fullscreen", 1]},
    {"client": "alice", "call": "ui", "args": ["options"]},
    {"client": "alice", "call": "expectState", "args": [{"hud.optionSections": "Mouse | Crosshair | Audio | Buy menu | Controls | Video | Frame pacing & latency"}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.rawHint": ""}]},
    {"client": "alice", "call": "rawInput", "args": [false]},
    {"client": "alice", "call": "expectState", "args": [{"hud.rawHint": ["has", "no raw mouse input"]}]},
    {"snapshot": "options-no-raw-input"},
    {"client": "alice", "call": "rawInput", "args": [true]},
    {"client": "alice", "call": "expectState", "args": [{"hud.rawHint": ""}]},
    {"client": "alice", "call": "cvar", "args": ["cl_loop", "unlocked"]},
    {"client": "alice", "call": "uiField", "args": [".fps-unlocked-preset", "500"]},
    {"client": "alice", "call": "expectState", "args": [{"settings.fps_max_unlocked": 500}]},
    {"client": "alice", "call": "uiField", "args": [".fps-unlocked", "1500"]},
    {"client": "alice", "call": "expectState", "args": [{"settings.fps_max_unlocked": 1500}]},
    {"snapshot": "options-unlocked-cap"},
    {"client": "alice", "call": "cvar", "args": ["cl_loop", "raf"]},
    {"client": "alice", "call": "ui", "args": ["controls"]},
    {"client": "alice", "call": "expectBinds", "args": [{"ControlLeft": "+duck", "KeyC": null, "Space": "+jump", "Mouse0": "+attack", "Mouse2": "+zoom"}]},
    {"snapshot": "controls"},
    {"client": "alice", "call": "uiRebind", "args": ["Jump", "KeyR"]},
    {"client": "alice", "call": "expectBinds", "args": [{"KeyR": "+jump", "Space": null}]},
    {"snapshot": "conflict-moved"},
    {"client": "alice", "call": "uiRebind", "args": ["Reload", "Mouse3"]},
    {"client": "alice", "call": "uiRebind", "args": ["Crouch", "MWheelDown"]},
    {"client": "alice", "call": "expectBinds", "args": [{"Mouse3": "reload", "MWheelDown": "+duck", "ControlLeft": null}]},
    {"client": "alice", "call": "exec", "args": ["unbind g"]},
    {"client": "alice", "call": "exec", "args": ["bind c +duck"]},
    {"client": "alice", "call": "expectBinds", "args": [{"KeyC": "+duck", "MWheelDown": null, "KeyG": null}]},
    {"snapshot": "after-console-binds"},
    {"client": "alice", "call": "exec", "args": ["bind space +jump"]},
    {"client": "alice", "call": "exec", "args": ["bind ctrl +duck"]},
    {"client": "alice", "call": "ui", "args": ["controls"]},
    {"client": "alice", "call": "uiRebind", "args": ["Reload", "KeyR"]},
    {"client": "alice", "call": "exec", "args": ["bind g drop"]},
    {"client": "alice", "call": "exec", "args": ["unbind mouse4"]},
    {"client": "alice", "call": "expectBinds", "args": [{"ControlLeft": "+duck", "Space": "+jump", "KeyR": "reload", "KeyG": "drop", "KeyC": null}]}
  ]
}
