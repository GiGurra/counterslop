{
  "description": "The crosshair shows the true spread (web/game/crosshair.js): its gap is the next shot's cone on screen, so it opens when running and in the air, closes when you stop (the 'shoot now' cue), is tighter crouched, and it stays centred: in a spray it opens by the part of the spray offset the view punch doesn't show (the next shot's cone sits above the centre) and closes again as the spray recovers. Snapshots: still, running, crouch-walking, air, air-crouched, spray, recovered, linter scoped, code review unscoped",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"client": "alice", "call": "exec", "args": ["give prompt"]},
    {"client": "alice", "call": "set", "args": [{"pos": [20, 0, -22], "yaw": 0, "pitch": -0.1}]},
    {"step": 60},
    {"client": "alice", "call": "expectState", "args": [{"crosshair.gap": ["<", 4], "crosshair.x": ["~", [0, 0.5]], "crosshair.y": ["~", [0, 0.5]]}]},
    {"client": "alice", "call": "markCrosshair", "args": ["still"]},
    {"snapshot": "still"},

    {"client": "alice", "call": "hold", "args": [["KeyS"]]},
    {"step": 40},
    {"client": "alice", "call": "expectCrosshair", "args": [">", "still", 4]},
    {"client": "alice", "call": "markCrosshair", "args": ["running"]},
    {"snapshot": "running"},

    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 30},
    {"client": "alice", "call": "expectCrosshair", "args": ["==", "still"]},

    {"client": "alice", "call": "hold", "args": [["KeyW", "ControlLeft"]]},
    {"step": 40},
    {"client": "alice", "call": "expectState", "args": [{"me.crouched": true}]},
    {"client": "alice", "call": "expectCrosshair", "args": ["<", "running", 0.6]},
    {"snapshot": "crouch-walking"},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 40},

    {"client": "alice", "call": "hold", "args": [["Space"]]},
    {"step": 12},
    {"client": "alice", "call": "expectState", "args": [{"me.onGround": false}]},
    {"client": "alice", "call": "expectCrosshair", "args": [">", "running"]},
    {"client": "alice", "call": "markCrosshair", "args": ["air"]},
    {"snapshot": "air"},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 80},
    {"client": "alice", "call": "hold", "args": [["Space"]]},
    {"step": 4},
    {"client": "alice", "call": "hold", "args": [["Space", "ControlLeft"]]},
    {"step": 8},
    {"client": "alice", "call": "expectState", "args": [{"me.onGround": false, "me.crouched": true}]},
    {"client": "alice", "call": "expectCrosshair", "args": ["<", "air", 0.7]},
    {"snapshot": "air-crouched"},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 80},
    {"client": "alice", "call": "expectCrosshair", "args": ["==", "still"]},

    {"client": "alice", "call": "hold", "args": [[], true]},
    {"step": 40},
    {"client": "alice", "call": "expectState", "args": [{"spray.idx": [">", 3], "crosshair.y": ["<", -2]}]},
    {"client": "alice", "call": "expectCrosshair", "args": [">", "still", 3]},
    {"snapshot": "spray"},
    {"client": "alice", "call": "hold", "args": [[], false]},
    {"step": 300},
    {"client": "alice", "call": "expectState", "args": [{"crosshair.y": ["~", [0, 0.5]], "crosshair.x": ["~", [0, 0.5]]}]},
    {"client": "alice", "call": "expectCrosshair", "args": ["==", "still"]},
    {"snapshot": "recovered"},

    {"client": "alice", "call": "cvar", "args": ["zoom_mode", "hold"]},
    {"client": "alice", "call": "exec", "args": ["give linter"]},
    {"step": 60},
    {"client": "alice", "call": "markCrosshair", "args": ["linter"]},
    {"client": "alice", "call": "hold", "args": [[], false, true]},
    {"step": 4},
    {"client": "alice", "call": "expectState", "args": [{"scoped": true}]},
    {"snapshot": "linter-scoped"},
    {"client": "alice", "call": "hold", "args": [[], false, false]},

    {"client": "alice", "call": "exec", "args": ["give codereview"]},
    {"step": 60},
    {"client": "alice", "call": "expectState", "args": [{"scoped": false}]},
    {"client": "alice", "call": "expectCrosshair", "args": [">", "still", 5]},
    {"snapshot": "review-unscoped"}
  ]
}
