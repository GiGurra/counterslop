{
  "description": "he_merge_hell: each side's spawn (the grenades-only loadout), an overview and orbit, the view from the merge commit, the LGTM wall along the north branch (alice throws an HE), then bob steps off the north branch and is merged into main (the kill feed says so)",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel he_merge_hell"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "expectState", "args": [{"map": "he_merge_hell", "team": "vibe", "screen": "playing", "hud.weapon": "Merge Conflict"}]},
    {"client": "bob", "call": "expectState", "args": [{"map": "he_merge_hell", "team": "artisan"}]},
    {"snapshot": "spawn"},
    {"client": "alice", "call": "camera", "args": ["overview"]},
    {"snapshot": "overview", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 0.7}]},
    {"snapshot": "orbit", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},
    {"client": "alice", "call": "set", "args": [{"pos": [-3.5, 0, 3], "yaw": -0.9, "pitch": -0.05}]},
    {"step": 20},
    {"snapshot": "merge-commit", "clients": ["alice"]},
    {"client": "alice", "call": "set", "args": [{"pos": [-24, 0, 14], "yaw": -0.6, "pitch": 0.35}]},
    {"step": 20},
    {"client": "alice", "call": "hold", "args": [["Mouse0"], 20]},
    {"step": 45},
    {"snapshot": "lgtm-wall", "clients": ["alice"]},
    {"client": "*", "call": "hud", "args": [true]},
    {"client": "bob", "call": "set", "args": [{"pos": [8, 0, 9.2], "yaw": 0, "pitch": -0.6}]},
    {"client": "bob", "call": "hold", "args": [["KeyW"], 60]},
    {"step": 120},
    {"snapshot": "merged-into-main", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
