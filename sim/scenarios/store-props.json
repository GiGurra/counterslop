{
  "description": "lab_store (store props test map, changelevel): gondola aisles, checkout lanes, demo kiosks under the skylight, carts, the stockroom shelf, the TV wall, LAN desks on arcade carpet, the escalator pair to the mezzanine, a player riding it, and the hall from outside",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel lab_store"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"map": "lab_store", "team": "vibe", "screen": "playing"}]},
    {"client": "alice", "call": "set", "args": [{"pos": [-6.5, 0.02, -10.4], "yaw": 1.5708, "pitch": -0.05}]},
    {"step": 4},
    {"client": "alice", "call": "expectState", "args": [{"me.pos.0": ["~", [-6.5, 0.1]], "me.pos.2": ["~", [-10.4, 0.1]]}]},
    {"snapshot": "aisle-first-person", "clients": ["alice"]},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-5, 2.4, 2.5], "yaw": 1.95, "pitch": -0.3}]},
    {"step": 2},
    {"snapshot": "checkouts", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [0.5, 1.8, 0.5], "yaw": 0, "pitch": -0.15}]},
    {"step": 2},
    {"snapshot": "kiosks-skylight", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [4.5, 2.2, -1.5], "yaw": -0.85, "pitch": -0.2}]},
    {"step": 2},
    {"snapshot": "stock-shelf-lan", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [13, 1.8, -5.2], "yaw": -1.5708, "pitch": -0.05}]},
    {"step": 2},
    {"snapshot": "tv-wall", "clients": ["alice"]},
    {"client": "bob", "call": "set", "args": [{"pos": [5.8, 1.27, 2.8], "yaw": -1.5708}]},
    {"client": "alice", "call": "camera", "args": [{"eye": [0.5, 2.2, 4.6], "yaw": -1.9, "pitch": -0.12}]},
    {"step": 4},
    {"snapshot": "escalators-mezzanine", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 0.4, "radius": 40, "height": 20}]},
    {"step": 2},
    {"snapshot": "outside", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
