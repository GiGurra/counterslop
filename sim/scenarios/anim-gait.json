{
  "description": "Silly gait (draw-only): runner, walker (shift), crouch-walker and jumper moving side by side north of mid (z 19-22.5: clear of the mid screens), seen from the side at a few frames, then standing still again",
  "clients": ["cam", "runner", "walker", "croucher", "jumper"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"client": "cam", "call": "set", "args": [{"pos": [-2, 0, 0], "yaw": 3.1416}]},
    {"client": "runner", "call": "set", "args": [{"pos": [-7, 0, 19], "yaw": -1.5708, "pitch": 0}]},
    {"client": "walker", "call": "set", "args": [{"pos": [-9, 0, 22.5], "yaw": -1.5708, "pitch": 0}]},
    {"client": "croucher", "call": "set", "args": [{"pos": [-13, 0, 22.5], "yaw": -1.5708, "pitch": 0}]},
    {"client": "jumper", "call": "set", "args": [{"pos": [-14, 0, 19], "yaw": -1.5708, "pitch": 0}]},
    {"wait": 400},
    {"step": 20},
    {"client": "cam", "call": "hud", "args": [false]},
    {"client": "cam", "call": "camera", "args": [{"eye": [-8, 1.3, 27], "yaw": 0, "pitch": -0.08}]},
    {"step": 2},
    {"snapshot": "rest", "clients": ["cam"]},
    {"client": "runner", "call": "hold", "args": [["KeyW"]]},
    {"client": "walker", "call": "hold", "args": [["KeyW", "ShiftLeft"]]},
    {"client": "croucher", "call": "hold", "args": [["KeyW", "ControlLeft"]]},
    {"client": "jumper", "call": "hold", "args": [["KeyW", "Space"]]},
    {"step": 30},
    {"client": "cam", "call": "expectState", "args": [{"byName.croucher.crouched": true}]},
    {"snapshot": "moving-a", "clients": ["cam"]},
    {"client": "cam", "call": "camera", "args": [{"eye": [-3.2, 0.8, 21.6], "yaw": 0, "pitch": -0.05}]},
    {"step": 4},
    {"snapshot": "moving-b", "clients": ["cam"]},
    {"step": 4},
    {"snapshot": "moving-c", "clients": ["cam"]},
    {"step": 4},
    {"client": "cam", "call": "expectState", "args": [{"byName.runner.gait.amp": [">", 0.5], "byName.walker.gait.amp": ["<", 0.8], "byName.croucher.gait.amp": [">", 0.2], "byName.jumper.gait.air": [">", 0.5], "byName.runner.gait.air": ["<", 0.1]}]},
    {"snapshot": "moving-d", "clients": ["cam"]},
    {"client": "runner", "call": "hold", "args": [[]]},
    {"client": "walker", "call": "hold", "args": [[]]},
    {"client": "croucher", "call": "hold", "args": [[]]},
    {"client": "jumper", "call": "hold", "args": [[]]},
    {"step": 60},
    {"client": "cam", "call": "camera", "args": [{"eye": [-6, 2.4, 30.5], "yaw": 0, "pitch": -0.17}]},
    {"step": 2},
    {"client": "cam", "call": "expectState", "args": [{"byName.runner.gait.amp": ["<", 0.05], "byName.walker.gait.amp": ["<", 0.05], "byName.croucher.gait.amp": ["<", 0.05], "byName.jumper.gait.amp": ["<", 0.05]}]},
    {"snapshot": "stopped", "clients": ["cam"]}
  ]
}
