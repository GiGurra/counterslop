{
  "description": "gs_megabyte's west escalator pair: the treads are moving solids (map movers), mid-cycle from the side and from the top, the handrails up close (no flicker); bob boards the up lane from the floor and rides it glued to his tread (alice watches his feet on the drawn step from close by: remote riders are drawn on the server's timeline, the steps on her own command clock), then rides the down lane to the foot; client and server in sync",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel gs_megabyte"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"map": "gs_megabyte", "screen": "playing"}]},
    {"client": "alice", "call": "expectState", "args": [{"gfx.beltSteps": [">", 60]}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-20.4, 0.25, -4.7], "yaw": 3.1416, "pitch": 0}]},
    {"step": 120},
    {"client": "bob", "call": "expectState", "args": [{"me.pos.2": ["~", [-3.3, 0.1]], "me.pos.1": [">", 0.8], "me.onGround": true}]},
    {"client": "bob", "call": "expectInSync"},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-20.4, 2.9, -5.6], "yaw": 3.1416, "pitch": -0.5}]},
    {"step": 2},
    {"snapshot": "rider-feet", "clients": ["alice"]},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-16, 3.5, -7], "yaw": 2.55, "pitch": -0.25}]},
    {"step": 2},
    {"snapshot": "side", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-19.65, 6.6, 6.5], "yaw": 0, "pitch": -0.45}]},
    {"step": 2},
    {"snapshot": "from-top", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-17.2, 2.2, -3.5], "yaw": 1.9, "pitch": -0.35}]},
    {"step": 2},
    {"snapshot": "rails-close", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-19.65, 2.2, -8], "yaw": 3.1416, "pitch": -0.3}]},
    {"step": 2},
    {"snapshot": "foot", "clients": ["alice"]},
    {"step": 18},
    {"snapshot": "foot-later", "clients": ["alice"]},
    {"client": "bob", "call": "set", "args": [{"pos": [-18.9, 5, 3.8], "yaw": 0, "pitch": 0}]},
    {"step": 780},
    {"client": "bob", "call": "expectState", "args": [{"me.pos.1": ["~", [0, 0.01]], "me.pos.2": ["<", -5]}]},
    {"client": "bob", "call": "expectInSync"},
    {"client": "alice", "call": "camera", "args": [null]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
