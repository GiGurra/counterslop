{
  "description": "E takes the weapon you look at: alice, Prompt in hand, looks down at the map's Code Review 1.2 m ahead; the HUD prompts 'E: take Code Review'; she presses E: the Code Review is in her hands and her Prompt lies where it was",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["mp_respawn 0; mp_freezetime 0; mp_round_restart_delay 30; mp_warmup_end"]},
    {"wait": 600},
    {"step": 10},
    {"client": "alice", "call": "exec", "args": ["give prompt; slot1"]},
    {"wait": 300},
    {"step": 40},
    {"client": "alice", "call": "set", "args": [{"pos": [-14, 0, 9.2], "yaw": 0, "pitch": -0.9}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-24, 0, 14], "yaw": 0}]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"hud.hint": "E: take Code Review", "hud.weapon": "The Prompt"}]},
    {"snapshot": "take-prompt", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [["KeyE"]]},
    {"step": 2},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"step": 30},
    {"client": "alice", "call": "waitState", "args": [{"hud.weapon": "Code Review", "items.length": 1, "items.0.w": "prompt"}]},
    {"step": 2},
    {"snapshot": "taken", "clients": ["alice"]}
  ]
}
