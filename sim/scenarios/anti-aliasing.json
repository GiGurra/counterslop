{
  "description": "Anti-aliasing (r_aa) and render scale (r_render_scale): the same first-person view of crate edges and shadows with the viewmodel, rendered off / MSAA 4x / FXAA / MSAA 4x + FXAA and at 50% scale, plus a muzzle flash and a scope through the offscreen path; Options → Video sets both",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"client": "alice", "call": "set", "args": [{"pos": [3, 0, 16], "yaw": -0.6, "pitch": -0.2}]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"settings.r_aa": "auto", "settings.r_render_scale": 100}]},
    {"snapshot": "auto"},
    {"client": "alice", "call": "cvar", "args": ["r_aa", "off"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"gfx.aa": "off"}]},
    {"snapshot": "off"},
    {"client": "alice", "call": "cvar", "args": ["r_aa", "msaa4"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"gfx.aa": ["has", "msaa4"]}]},
    {"snapshot": "msaa4"},
    {"client": "alice", "call": "cvar", "args": ["r_aa", "fxaa"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"gfx.aa": "fxaa"}]},
    {"snapshot": "fxaa"},
    {"client": "alice", "call": "cvar", "args": ["r_aa", "msaa4_fxaa"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"gfx.aa": ["has", "msaa4+fxaa"]}]},
    {"snapshot": "msaa4-fxaa"},
    {"client": "alice", "call": "cvar", "args": ["r_render_scale", 50]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"gfx.renderScale": 0.5}]},
    {"snapshot": "msaa4-fxaa-scale50"},
    {"client": "alice", "call": "hold", "args": [[], true]},
    {"step": 1},
    {"client": "alice", "call": "hold", "args": [[], false]},
    {"snapshot": "muzzle-flash-fxaa-scale50"},
    {"client": "alice", "call": "exec", "args": ["give codereview"]},
    {"wait": 300},
    {"step": 30},
    {"client": "alice", "call": "mouseClick", "args": [2]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"scoped": true, "gfx.aa": ["has", "fxaa"]}]},
    {"snapshot": "scoped-fxaa-scale50"},
    {"client": "alice", "call": "mouseClick", "args": [2]},
    {"client": "alice", "call": "ui", "args": ["options"]},
    {"client": "alice", "call": "uiField", "args": [".aa-mode", "fxaa"]},
    {"client": "alice", "call": "uiField", "args": [".render-scale", 75]},
    {"client": "alice", "call": "expectState", "args": [{"settings.r_aa": "fxaa", "settings.r_render_scale": 75}]},
    {"snapshot": "options-video"},
    {"client": "alice", "call": "ui", "args": ["play"]},
    {"client": "alice", "call": "cvar", "args": ["r_aa", "auto"]},
    {"client": "alice", "call": "cvar", "args": ["r_render_scale", 100]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"settings.r_aa": "auto", "gfx.renderScale": 1}]}
  ]
}
