{
  "description": "Tickets mode on lab_conquest (Star Slop phase 1): Earth's and the Moon's ticket backlogs in the top bar, the points strip under it (the mains held, C's bar filling while alice stands in it), then bob shoots alice and her spawn screen comes up: the countdown, the map overview with the points (Earth's main to click), AUTO and the four kits; she picks the Staff Engineer.",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel lab_conquest"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"client": "alice", "call": "exec", "args": ["mp_freezetime 0; mp_warmup_time 0; mp_round_restart_delay 30; mp_respawn_delay 600; kit intern; mp_respawn 0"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "live"}]},
    {"client": "alice", "call": "expectState", "args": [{"map": "lab_conquest", "round.mode": "tickets", "hud.tickets.tickets.vibe": 150, "hud.tickets.tickets.artisan": 150, "hud.tickets.spawn": null}]},
    {"client": "alice", "call": "set", "args": [{"pos": [0, 0, 0], "yaw": -1.5708, "pitch": -0.08}]},
    {"client": "bob", "call": "set", "args": [{"pos": [40, 0, 20], "yaw": 0, "pitch": 0}]},
    {"wait": 300},
    {"step": 300},
    {"client": "alice", "call": "expectState", "args": [{"hud.tickets.points.3.by": "vibe", "hud.tickets.points.3.own": ""}]},
    {"snapshot": "backlog-and-points", "clients": ["alice"]},
    {"client": "bob", "call": "set", "args": [{"pos": [0, 0, 7], "yaw": 0, "pitch": -0.05}]},
    {"wait": 200},
    {"step": 5},
    {"client": "bob", "call": "hold", "args": [["Mouse0"], 90]},
    {"step": 90},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"hud.hp": 0}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.tickets.tickets.vibe": 149, "hud.tickets.spawn.at": "earth", "hud.tickets.spawn.pick": "auto"}]},
    {"client": "alice", "call": "exec", "args": ["kit staff"]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.tickets.spawn.kit": "staff"}]},
    {"snapshot": "spawn-screen", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["kit intern; changelevel de_slop"]},
    {"wait": 400}
  ]
}
