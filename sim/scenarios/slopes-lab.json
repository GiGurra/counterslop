{
  "description": "lab_slopes (wedges, changelevel): bob runs up the 30 degree ramp onto its 2.3 m ledge, slides back down the 60 degree one and off the surf ridge's side, predicted in sync; views of the ramp row, the deck with its ramps down, the surf ridge and the target ramp, and the yard from above",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel lab_slopes"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"map": "lab_slopes", "team": "vibe", "screen": "playing"}]},

    {"client": "bob", "call": "set", "args": [{"pos": [-27, 0, -19.5], "yaw": -1.5708, "pitch": 0}]},
    {"client": "bob", "call": "hold", "args": [["KeyW"]]},
    {"step": 72},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"step": 30},
    {"client": "bob", "call": "expectState", "args": [{"me.pos.1": ["~", [2.31, 0.001]], "me.pos.0": [">", -20], "me.onGround": true}]},
    {"client": "bob", "call": "expectInSync"},

    {"client": "bob", "call": "set", "args": [{"pos": [-21, 6, -9.5], "yaw": 0, "pitch": 0}]},
    {"step": 60},
    {"client": "bob", "call": "expectState", "args": [{"me.pos.0": ["<", -23], "me.pos.1": ["<", 2]}]},
    {"client": "bob", "call": "expectInSync"},

    {"client": "bob", "call": "set", "args": [{"pos": [12, 3.5, -10], "yaw": 0, "pitch": 0}]},
    {"step": 60},
    {"client": "bob", "call": "expectState", "args": [{"me.pos.0": ["<", 11], "me.pos.1": ["~", [0, 0.01]]}]},
    {"client": "bob", "call": "expectInSync"},

    {"client": "bob", "call": "set", "args": [{"pos": [-3, 2, -21], "yaw": 0.6, "pitch": 0}]},
    {"step": 10},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-10, 5, -2], "yaw": 0.675, "pitch": -0.25}]},
    {"step": 2},
    {"snapshot": "ramp-row", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [7, 4, -11], "yaw": 0.73, "pitch": -0.25}]},
    {"step": 2},
    {"snapshot": "deck", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [14, 3, 12], "yaw": 0, "pitch": -0.1}]},
    {"step": 2},
    {"snapshot": "surf-ridge", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"eye": [0, 2, 2], "yaw": 3.1416, "pitch": -0.2}]},
    {"step": 2},
    {"snapshot": "target-ramp", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 0.6, "radius": 45, "height": 28}]},
    {"step": 2},
    {"snapshot": "overview", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
