{
  "description": "Buy menu edges in a real round (not warmup): keyboard numbers per category and team (gear 3 is the Sunglasses for Vibe Coders, the Rollback Kit for Artisans), a helmet on $800 is refused (can't afford), the vest then shows owned and a second one is refused, the Stub you hold is owned, and walking out of the buy zone closes the menu and B won't reopen it",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["mp_freezetime 30"]},
    {"client": "alice", "call": "exec", "args": ["mp_respawn 0"]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "freeze"}]},
    {"client": "*", "call": "expectState", "args": [{"hud.money": 800, "hud.canBuy": true}]},

    {"client": "*", "call": "keyTap", "args": ["KeyB"]},
    {"step": 2},
    {"client": "*", "call": "keyTap", "args": ["Digit5"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"hud.buyMenu": true, "hud.buyItems": "1 Senior-dev Hoodie $650 | 2 Hoodie + Noise-cancelling Headphones $1000 x | 3 Senior-dev Sunglasses $200 | 4 10x Energy Drink $300"}]},
    {"client": "bob", "call": "expectState", "args": [{"hud.buyItems": ["has", "3 Rollback Kit $400"]}]},

    {"client": "alice", "call": "keyTap", "args": ["Digit2"]},
    {"step": 2},
    {"client": "alice", "call": "waitState", "args": [{"hud.buyMsg": "can't afford it"}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.money": 800, "hud.armor": 0, "hud.helmet": false}]},

    {"client": "alice", "call": "keyTap", "args": ["Digit1"]},
    {"client": "bob", "call": "keyTap", "args": ["Digit3"]},
    {"step": 2},
    {"wait": 100},
    {"step": 2},
    {"client": "alice", "call": "waitState", "args": [{"hud.armor": 100, "hud.money": 150}]},
    {"client": "bob", "call": "waitState", "args": [{"hud.kit": true, "hud.money": 400}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.buyItems": ["has", "1 Senior-dev Hoodie owned x"]}]},
    {"client": "alice", "call": "keyTap", "args": ["Digit1"]},
    {"step": 2},
    {"client": "alice", "call": "waitState", "args": [{"hud.buyMsg": "already wearing it"}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.money": 150}]},

    {"client": "alice", "call": "keyTap", "args": ["Backspace"]},
    {"step": 2},
    {"client": "alice", "call": "keyTap", "args": ["Digit1"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"hud.buyItems": ["has", "1 The Stub owned x"]}]},
    {"client": "alice", "call": "keyTap", "args": ["Digit1"]},
    {"step": 2},
    {"client": "alice", "call": "waitState", "args": [{"hud.buyMsg": "already have one"}]},
    {"snapshot": "pistols", "clients": ["alice"]},

    {"client": "alice", "call": "set", "args": [{"pos": [0, 0, 0]}]},
    {"step": 5},
    {"wait": 100},
    {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"hud.canBuy": false, "hud.buyMenu": false}]},
    {"client": "alice", "call": "keyTap", "args": ["KeyB"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"hud.buyMenu": false, "hud.money": 150}]}
  ]
}
