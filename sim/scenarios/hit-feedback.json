{
  "description": "Hit feedback: alice shoots a frozen bot at 10 m (head) and 25 m (body): the slop burst reads at both (no hit marker); bob taps alice in the legs from her right (red vignette on the right + view flinch), again until she is under 25 HP (a grey rim pulsing with the heartbeat), then headshots her (burst, kill confirm)",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"client": "alice", "call": "exec", "args": ["bot_kick"]},
    {"client": "alice", "call": "exec", "args": ["bot_add"]},
    {"wait": 300},
    {"client": "alice", "call": "exec", "args": ["bot_freeze 1"]},
    {"client": "alice", "call": "exec", "args": ["rcon bot_teleport -14 0 0 0"]},
    {"client": "alice", "call": "exec", "args": ["rcon weapon_spread 0"]},
    {"client": "bob", "call": "set", "args": [{"pos": [-12, 0, 20], "yaw": 0, "pitch": 0}]},
    {"wait": 300},
    {"client": "alice", "call": "shootBot", "args": ["head", 3.14159, 10]},
    {"step": 10},
    {"client": "alice", "call": "waitState", "args": [{"lastHit.part": "head", "hurtFx.bursts": [">", 12], "dmgNumbers": 0}]},
    {"snapshot": "burst-10m-headshot", "clients": ["alice"]},
    {"step": 40},
    {"client": "alice", "call": "expectState", "args": [{"hurtFx.bursts": 0}]},
    {"client": "alice", "call": "shootBot", "args": ["body", 3.14159, 25]},
    {"step": 10},
    {"client": "alice", "call": "waitState", "args": [{"lastHit.part": "body", "hurtFx.bursts": [">", 12]}]},
    {"snapshot": "burst-25m-body", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["bot_kick"]},
    {"client": "alice", "call": "set", "args": [{"pos": [-20, 0, 8], "yaw": 0, "pitch": 0}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-12, 0, 8], "yaw": 1.5708, "pitch": -0.169}]},
    {"wait": 400},
    {"step": 30},
    {"client": "bob", "call": "hold", "args": [[], true]},
    {"step": 1},
    {"client": "bob", "call": "hold", "args": [[], false]},
    {"step": 1},
    {"wait": 200},
    {"step": 4},
    {"client": "alice", "call": "waitState", "args": [{"hud.hp": ["<", 100], "hurtFx.edges": 1, "hurtFx.alpha": [">", 0.2]}]},
    {"client": "alice", "call": "expectState", "args": [{"me.yaw": 0, "me.pitch": 0, "hurtFx.flinchDeg": [">", 0.3]}]},
    {"snapshot": "hurt-vignette-flinch"},
    {"step": 30},
    {"client": "alice", "call": "expectState", "args": [{"hurtFx.edges": 0}]},
    {"client": "bob", "call": "hold", "args": [[], true]},
    {"step": 1},
    {"client": "bob", "call": "hold", "args": [[], false]},
    {"step": 20},
    {"client": "bob", "call": "hold", "args": [[], true]},
    {"step": 1},
    {"client": "bob", "call": "hold", "args": [[], false]},
    {"step": 20},
    {"client": "bob", "call": "hold", "args": [[], true]},
    {"step": 1},
    {"client": "bob", "call": "hold", "args": [[], false]},
    {"step": 1},
    {"wait": 200},
    {"step": 40},
    {"client": "alice", "call": "waitState", "args": [{"hud.hp": ["<", 26], "hurtFx.lowHp": [">", 0.3], "hurtFx.edges": 0}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.hp": [">", 0]}]},
    {"snapshot": "low-hp-edges"},
    {"client": "bob", "call": "set", "args": [{"pos": [-12, 0, 8], "yaw": 1.5708, "pitch": -0.0025}]},
    {"wait": 300},
    {"step": 10},
    {"client": "bob", "call": "hold", "args": [[], true]},
    {"step": 1},
    {"client": "bob", "call": "hold", "args": [[], false]},
    {"step": 1},
    {"wait": 200},
    {"step": 3},
    {"client": "bob", "call": "waitState", "args": [{"hurtFx.bursts": [">", 10]}]},
    {"client": "alice", "call": "waitState", "args": [{"hud.hp": 0}]},
    {"snapshot": "kill"},
    {"client": "alice", "call": "exec", "args": ["rcon weapon_spread 1"]}
  ]
}
