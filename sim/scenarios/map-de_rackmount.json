{
  "description": "de_rackmount: each side's spawn, an overview and orbit, site A from the floor, then the Gravity Override's view of the map: standing on the north side panel and on the ceiling board (changelevel from the console)",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_rackmount"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "expectState", "args": [{"map": "de_rackmount", "team": "vibe", "screen": "playing"}]},
    {"client": "bob", "call": "expectState", "args": [{"map": "de_rackmount", "team": "artisan"}]},
    {"snapshot": "spawn"},
    {"client": "alice", "call": "camera", "args": ["overview"]},
    {"snapshot": "overview", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 0.7}]},
    {"snapshot": "orbit", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},
    {"client": "bob", "call": "set", "args": [{"pos": [24, 0, 17], "yaw": 1.2, "pitch": 0.15}]},
    {"step": 20},
    {"snapshot": "site-a", "clients": ["bob"]},
    {"client": "alice", "call": "set", "args": [{"boots": true}]},
    {"client": "alice", "call": "set", "args": [{"pos": [-30, 8, 19.95], "yaw": -1.5708, "pitch": 0, "grav": 5}]},
    {"step": 40},
    {"client": "alice", "call": "expectState", "args": [{"me.grav": 5}]},
    {"snapshot": "on-the-panel", "clients": ["alice"]},
    {"client": "alice", "call": "set", "args": [{"pos": [-28, 15.95, -10], "yaw": 1.5708, "pitch": -0.25, "grav": 1}]},
    {"step": 40},
    {"client": "alice", "call": "expectState", "args": [{"me.grav": 1}]},
    {"snapshot": "on-the-ceiling", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
