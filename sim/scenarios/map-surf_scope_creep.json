{
  "description": "surf_scope_creep (competitive surf map; its Rules pin source movement, air accelerate 150, auto bunny hop): overview and orbits, each side's deck, alice running off the Vibe deck onto the A ridge and surfing it with the strafe key only (predicted in sync), the ride seen from behind, the legacy-path bridge, site A, and the void of deprecated code from site A's edge",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel surf_scope_creep"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"step": 10},
    {"client": "*", "call": "hud", "args": [false]},
    {"client": "alice", "call": "expectState", "args": [{"map": "surf_scope_creep", "team": "vibe", "screen": "playing"}]},
    {"client": "bob", "call": "expectState", "args": [{"map": "surf_scope_creep", "team": "artisan"}]},
    {"snapshot": "spawn"},
    {"client": "alice", "call": "camera", "args": ["overview"]},
    {"snapshot": "overview", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 0.7, "radius": 110, "height": 50}]},
    {"snapshot": "orbit", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [{"orbit": 3.8, "radius": 110, "height": 50}]},
    {"snapshot": "orbit2", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},

    {"client": "alice", "call": "set", "args": [{"pos": [-34, 12, 84], "yaw": 0, "pitch": -0.25}]},
    {"step": 10},
    {"snapshot": "deck-edge", "clients": ["alice"]},
    {"client": "alice", "call": "hold", "args": [["KeyW"]]},
    {"step": 80},
    {"client": "alice", "call": "expectState", "args": [{"me.onGround": false, "me.pos.2": ["<", 77.6]}]},
    {"client": "alice", "call": "hold", "args": [["KeyD"]]},
    {"step": 90},
    {"client": "alice", "call": "expectState", "args": [{"me.onGround": false, "me.pos.0": [">", -39], "me.pos.1": [">", 2], "me.pos.2": ["<", 70]}]},
    {"client": "alice", "call": "expectInSync"},
    {"snapshot": "surfing", "clients": ["alice"]},
    {"client": "bob", "call": "camera", "args": [{"eye": [-44, 12, 72], "yaw": -0.6, "pitch": -0.25}]},
    {"step": 2},
    {"snapshot": "surfing-from-behind", "clients": ["bob"]},
    {"client": "bob", "call": "camera", "args": [null]},
    {"client": "alice", "call": "hold", "args": [[]]},

    {"client": "alice", "call": "set", "args": [{"pos": [0, 4, 40], "yaw": 0, "pitch": -0.1}]},
    {"step": 10},
    {"client": "alice", "call": "expectState", "args": [{"me.onGround": true, "me.pos.1": ["~", [4, 0.01]]}]},
    {"snapshot": "legacy-bridge", "clients": ["alice"]},
    {"client": "alice", "call": "set", "args": [{"pos": [-22, 4, -30], "yaw": 1.5708, "pitch": -0.15}]},
    {"step": 10},
    {"snapshot": "site-a", "clients": ["alice"]},
    {"client": "alice", "call": "set", "args": [{"pos": [-41.5, 4, -30], "yaw": 1.5708, "pitch": -0.8}]},
    {"step": 10},
    {"snapshot": "the-void", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
    {"wait": 400}
  ]
}
