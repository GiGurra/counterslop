{
  "description": "Teams: team-select on join, Vibe Coders vs Artisans outfits, spectating, a full side, scoreboard, a switch",
  "clients": ["alice", "bob", "dave", "cam"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", null]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"teamMenu": true, "team": "spec"}]},
    {"snapshot": "select-on-join", "clients": ["alice"]},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "auto"]},
    {"client": "dave", "call": "join", "args": ["dave", "vibe"]},
    {"client": "cam", "call": "join", "args": ["cam", "spec"]},
    {"wait": 300},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"team": "vibe"}]},
    {"client": "bob", "call": "expectState", "args": [{"team": "artisan"}]},
    {"client": "dave", "call": "expectState", "args": [{"team": "vibe"}]},
    {"snapshot": "at-spawn", "clients": ["alice", "bob"]},
    {"client": "cam", "call": "expectState", "args": [{"team": "spec"}]},
    {"snapshot": "spectating", "clients": ["cam"]},
    {"client": "cam", "call": "ui", "args": ["teammenu"]},
    {"client": "cam", "call": "expectState", "args": [{"teamMenu": true}]},
    {"snapshot": "select-vibe-full", "clients": ["cam"]},
    {"client": "cam", "call": "ui", "args": ["play"]},
    {"client": "cam", "call": "exec", "args": ["jointeam vibe"]},
    {"wait": 200},
    {"client": "cam", "call": "ui", "args": ["play"]},
    {"step": 2},
    {"client": "cam", "call": "expectState", "args": [{"team": "spec"}]},
    {"snapshot": "refused-full", "clients": ["cam"]},
    {"client": "alice", "call": "set", "args": [{"pos": [-24, 0, -1.3], "yaw": 1.2}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-24, 0, 1.3], "yaw": 1.9}]},
    {"client": "dave", "call": "set", "args": [{"pos": [-30, 0, 20]}]},
    {"wait": 300},
    {"step": 10},
    {"client": "cam", "call": "hud", "args": [false]},
    {"client": "cam", "call": "camera", "args": [{"eye": [-28.2, 1.9, 0.4], "yaw": -1.5708, "pitch": -0.15}]},
    {"step": 2},
    {"snapshot": "outfits-front", "clients": ["cam"]},
    {"client": "cam", "call": "camera", "args": [{"eye": [-19.8, 1.7, 0], "yaw": 1.5708, "pitch": -0.12}]},
    {"step": 2},
    {"snapshot": "outfits-back", "clients": ["cam"]},
    {"client": "cam", "call": "camera", "args": [{"eye": [-28.2, 1.9, 0.4], "yaw": -1.5708, "pitch": -0.15}]},
    {"client": "cam", "call": "cvar", "args": ["cl_showhitboxes", 1]},
    {"step": 2},
    {"snapshot": "outfits-hitboxes", "clients": ["cam"]},
    {"client": "cam", "call": "cvar", "args": ["cl_showhitboxes", 0]},
    {"client": "alice", "call": "set", "args": [{"crouch": true}]},
    {"client": "bob", "call": "set", "args": [{"crouch": true}]},
    {"client": "alice", "call": "hold", "args": [["ControlLeft"]]},
    {"client": "bob", "call": "hold", "args": [["ControlLeft"]]},
    {"wait": 300},
    {"step": 10},
    {"client": "cam", "call": "expectState", "args": [{"byName.alice.crouched": true, "byName.bob.crouched": true}]},
    {"snapshot": "outfits-crouched", "clients": ["cam"]},
    {"client": "alice", "call": "hold", "args": [[]]},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"client": "alice", "call": "set", "args": [{"crouch": false}]},
    {"client": "bob", "call": "set", "args": [{"crouch": false}]},
    {"wait": 200},
    {"client": "alice", "call": "ui", "args": ["scoreboard"]},
    {"client": "alice", "call": "expectState", "args": [{"scoreboard": true}]},
    {"snapshot": "scoreboard", "clients": ["alice"]},
    {"client": "alice", "call": "ui", "args": ["teammenu"]},
    {"client": "alice", "call": "expectState", "args": [{"teamMenu": true}]},
    {"snapshot": "teammenu", "clients": ["alice"]},
    {"client": "alice", "call": "ui", "args": ["play"]},
    {"client": "dave", "call": "team", "args": ["artisan"]},
    {"client": "bob", "call": "team", "args": ["vibe"]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "ui", "args": ["scoreboard"]},
    {"client": "alice", "call": "expectState", "args": [{"scoreboard": true, "team": "vibe", "byName.bob.team": "vibe", "byName.dave.team": "artisan"}]},
    {"snapshot": "after-switch", "clients": ["alice"]}
  ]
}
