{
  "description": "Death drop: in a live round alice one-shots bob, who carries the Linter with his pistol in hand; the Linter (and nothing else) drops at his body, settled on the floor beside it; the map's own Code Review lies 2 m behind (side view of the body and the gun, then from alice)",
  "clients": ["alice", "bob", "carol"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "carol", "call": "join", "args": ["carol", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["mp_respawn 0; mp_freezetime 0; mp_round_restart_delay 30; mp_warmup_end"]},
    {"wait": 600},
    {"step": 10},
    {"client": "alice", "call": "exec", "args": ["give codereview"]},
    {"client": "bob", "call": "exec", "args": ["give linter; slot2"]},
    {"wait": 300},
    {"step": 40},
    {"client": "alice", "call": "set", "args": [{"pos": [-14, 0, 0], "yaw": 3.1416, "pitch": -0.05}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-14, 0, 6], "yaw": 0}]},
    {"client": "carol", "call": "set", "args": [{"pos": [-24, 0, 14], "yaw": 0}]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"items.length": 1, "items.0.w": "codereview"}]},
    {"client": "alice", "call": "hold", "args": [[], true]},
    {"step": 1},
    {"client": "alice", "call": "hold", "args": [[], false]},
    {"step": 60},
    {"client": "alice", "call": "waitState", "args": [{"corpses": 1, "items.length": 2, "items.1.w": "linter", "items.1.p.1": ["~", [0, 0.01]], "items.1.p.0": ["~", [-14, 1.1]], "items.1.p.2": ["~", [6, 1.1]]}]},
    {"client": "alice", "call": "camera", "args": [{"eye": [-9.5, 1.2, 7.2], "yaw": 1.5708, "pitch": -0.2}]},
    {"snapshot": "dropped-by-the-body", "clients": ["alice"]},
    {"client": "alice", "call": "camera", "args": [null]},
    {"step": 2},
    {"snapshot": "from-the-killer", "clients": ["alice"]}
  ]
}
