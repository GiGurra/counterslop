{
  "description": "The tickets spawn screen takes real clicks (it used to let every click through to the game: #hud is pointer-events none). cq_moonshot: bob shoots alice in Earth's check-in hall, her spawn screen comes up with the cursor free (no pointer lock); Terminal 0 is Earth's only spawn point there, so the screen says so instead of offering AUTO and that one point; a trusted click on the Senior Sniper kit picks it and she respawns on Earth's side (Terminal 0, or aboard MVP-1 while it boards) with the Code Review. lab_conquest: alice holds A (the launch pad, a spawn point), dies, and trusted clicks on A's button, then on AUTO, then on A's circle on the map pick each; she respawns at A",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["changelevel cq_moonshot"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"client": "alice", "call": "exec", "args": ["mp_freezetime 0; mp_warmup_time 0; mp_round_restart_delay 30; mp_respawn_delay 8; kit intern; mp_respawn 0"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "live"}]},
    {"client": "alice", "call": "set", "args": [{"pos": [-262, 0, 0], "yaw": 3.1416, "pitch": -0.08}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-262, 0, 7], "yaw": 0, "pitch": -0.05}]},
    {"wait": 200},
    {"step": 5},
    {"client": "bob", "call": "hold", "args": [["Mouse0"], 90]},
    {"step": 90},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"client": "bob", "call": "set", "args": [{"pos": [-200, 0, 40], "yaw": 0, "pitch": 0}]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"hud.hp": 0}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.tickets.spawn.only": "Terminal 0", "hud.tickets.spawn.fixed": true, "hud.tickets.spawn.kit": "intern", "pointerLocked": false,
      "spawnOnly": "Deploying at Terminal 0: your team's only spawn point on this map", "deployButtons": ""}]},
    {"snapshot": "moonshot-spawn-screen", "clients": ["alice"]},
    {"client": "alice", "clickOn": ".spawn-screen .ss-kit[data-kit=senior]"},
    {"wait": 200},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.tickets.spawn.kit": "senior"}]},
    {"snapshot": "moonshot-kit-picked", "clients": ["alice"]},
    {"wait": 8000},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.hp": 100, "hud.tickets.spawn": null, "hud.weapon": "Code Review", "me.pos.0": ["<", -150]}]},
    {"client": "alice", "call": "exec", "args": ["kit intern; changelevel lab_conquest"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["vibe"]},
    {"client": "bob", "call": "team", "args": ["artisan"]},
    {"wait": 400},
    {"client": "alice", "call": "exec", "args": ["mp_freezetime 0; mp_warmup_time 0; mp_round_restart_delay 30; mp_respawn_delay 8; mp_respawn 0"]},
    {"wait": 400},
    {"step": 10},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "live"}]},
    {"client": "alice", "call": "set", "args": [{"pos": [-32, 0, 0], "yaw": 0, "pitch": 0}]},
    {"client": "bob", "call": "set", "args": [{"pos": [40, 0, 20], "yaw": 0, "pitch": 0}]},
    {"wait": 12000},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.tickets.points.1.own": "vibe"}]},
    {"client": "alice", "call": "set", "args": [{"pos": [-32, 0, 2], "yaw": 3.1416, "pitch": -0.08}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-32, 0, 9], "yaw": 0, "pitch": -0.05}]},
    {"wait": 200},
    {"step": 5},
    {"client": "bob", "call": "hold", "args": [["Mouse0"], 90]},
    {"step": 90},
    {"client": "bob", "call": "hold", "args": [[]]},
    {"client": "bob", "call": "set", "args": [{"pos": [40, 0, 20], "yaw": 0, "pitch": 0}]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"hud.hp": 0}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.tickets.spawn.only": "", "hud.tickets.spawn.pick": "auto", "spawnOnly": "", "deployButtons": "auto,earth,A"}]},
    {"client": "alice", "clickOn": ".spawn-screen .ss-btn[data-pt=A]"},
    {"wait": 200},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.tickets.spawn.pick": "A"}]},
    {"client": "alice", "clickOn": ".spawn-screen .ss-auto"},
    {"wait": 200},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.tickets.spawn.pick": "auto"}]},
    {"client": "alice", "clickOn": ".spawn-screen .ss-pt[data-pt=A] circle"},
    {"wait": 200},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.tickets.spawn.pick": "A"}]},
    {"snapshot": "conquest-point-picked", "clients": ["alice"]},
    {"wait": 8000},
    {"step": 5},
    {"client": "alice", "call": "expectState", "args": [{"hud.hp": 100, "hud.tickets.spawn": null, "me.pos.0": ["~", [-32, 6]]}]},
    {"client": "alice", "call": "exec", "args": ["kit intern; changelevel de_slop"]},
    {"wait": 400}
  ]
}
