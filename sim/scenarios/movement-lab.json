{
 "description": "Map rules: on de_slop the client predicts with the server's classic movement; changelevel lab_bhop, whose Rules pin sv_movement source and sv_autobunnyhopping 1, switches the prediction to source + auto bhop (whatever the server cvars say); alice runs and holds jump down the runway (hopping: auto bhop), bob watches; Server settings shows the Movement section with the two pinned rows; back on de_slop it is classic again.",
 "clients": ["alice", "bob"],
 "steps": [
  {"client": "*", "call": "time", "args": [40]},
  {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
  {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
  {"wait": 300},
  {"client": "alice", "call": "expectState", "args": [{"movement.model": 0, "movement.autoBhop": false}]},
  {"client": "alice", "call": "exec", "args": ["changelevel lab_bhop"]},
  {"wait": 400},
  {"client": "alice", "call": "team", "args": ["vibe"]},
  {"client": "bob", "call": "team", "args": ["artisan"]},
  {"wait": 400},
  {"step": 10},
  {"client": "*", "call": "expectState", "args": [{"map": "lab_bhop", "movement.model": 1, "movement.autoBhop": true, "cvars.sv_movement": "classic"}]},
  {"client": "alice", "call": "set", "args": [{"pos": [-6, 0, 0], "yaw": -1.5708, "pitch": 0}]},
  {"client": "bob", "call": "set", "args": [{"pos": [24, 0, 6], "yaw": 1.3, "pitch": -0.03}]},
  {"wait": 200},
  {"client": "alice", "call": "hold", "args": [["KeyW", "Space"]]},
  {"step": 60},
  {"client": "alice", "call": "expectState", "args": [{"me.jumps": [">", 1]}]},
  {"snapshot": "bhop-runway", "clients": ["bob", "alice"]},
  {"client": "alice", "call": "hold", "args": [[]]},
  {"wait": 600},
  {"client": "alice", "call": "ui", "args": ["server"]},
  {"step": 2},
  {"client": "alice", "call": "waitState", "args": [{"pinnedRows": "sv_movement,sv_autobunnyhopping", "serverSettings.sv_movement": "classic", "serverSettings.sv_airaccelerate": "12"}]},
  {"client": "alice", "call": "scrollTo", "args": [".server-settings section:has([data-cvar=sv_movement])"]},
  {"step": 2},
  {"snapshot": "settings-pinned", "clients": ["alice"]},
  {"client": "alice", "call": "ui", "args": ["play"]},
  {"client": "alice", "call": "exec", "args": ["changelevel de_slop"]},
  {"wait": 400},
  {"step": 10},
  {"client": "*", "call": "expectState", "args": [{"map": "de_slop", "movement.model": 0, "movement.autoBhop": false}]}
 ]
}
