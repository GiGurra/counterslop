{
  "description": "Server settings (main menu, admins only): bob (not admin) has no entry; alice logs in, opens it from the in-game menu, turns team limits and auto balance off, sv_showimpacts on (Practice) and trims the map rotation; bob sees the changes in the cvars, and logging out takes the entry away",
  "adminPassword": "pw",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"wait": 300},
    {"client": "*", "call": "ui", "args": ["menu"]},
    {"client": "*", "call": "expectState", "args": [{"admin": false, "menuButtons": ["lacks", "SERVER SETTINGS"], "screen": "ingame"}]},
    {"snapshot": "menu-not-admin", "clients": ["bob"]},
    {"client": "alice", "call": "exec", "args": ["admin_login pw"]},
    {"wait": 200},
    {"client": "alice", "call": "waitState", "args": [{"admin": true}]},
    {"client": "alice", "call": "ui", "args": ["menu"]},
    {"client": "alice", "call": "expectState", "args": [{"menuButtons": ["has", "SERVER SETTINGS"]}]},
    {"client": "bob", "call": "expectState", "args": [{"admin": false, "menuButtons": ["lacks", "SERVER SETTINGS"]}]},
    {"snapshot": "menu-admin", "clients": ["alice"]},
    {"client": "alice", "call": "ui", "args": ["server"]},
    {"client": "alice", "call": "waitState", "args": [{"serverSettings.mp_limitteams": "1", "serverSettings.mp_autoteambalance": "auto", "serverSettings.mp_friendlyfire": "0",
      "serverSettings.mp_roundtime": "115", "serverSettings.bot_difficulty": "1", "serverSettings.sv_showimpacts": "0", "serverSettings.rotation": ["has", "de_slop"]}]},
    {"snapshot": "server-settings", "clients": ["alice"]},
    {"client": "alice", "call": "serverSetting", "args": ["mp_limitteams", "0"]},
    {"client": "alice", "call": "serverSetting", "args": ["mp_autoteambalance", "0"]},
    {"client": "alice", "call": "serverSetting", "args": ["mp_friendlyfire", "1"]},
    {"client": "alice", "call": "serverSetting", "args": ["mp_roundtime", "5"]},
    {"client": "alice", "call": "serverSetting", "args": ["map:de_slop", "0"]},
    {"client": "alice", "call": "serverSetting", "args": ["sv_showimpacts", "1"]},
    {"wait": 300},
    {"step": 2},
    {"client": "alice", "call": "waitState", "args": [{"serverSettings.mp_limitteams": "0", "serverSettings.mp_autoteambalance": "0", "serverSettings.mp_friendlyfire": "1",
      "serverSettings.mp_roundtime": "10", "serverSettings.sv_showimpacts": "1", "serverSettings.rotation": ["lacks", "de_slop"]}]},
    {"client": "bob", "call": "expectState", "args": [{"cvars.mp_limitteams": "0", "cvars.mp_autoteambalance": "0", "cvars.mp_roundtime": "10"}]},
    {"viewport": [1280, 1700]},
    {"snapshot": "server-settings-changed", "clients": ["alice"]},
    {"client": "alice", "call": "exec", "args": ["admin_logout"]},
    {"wait": 200},
    {"client": "alice", "call": "waitState", "args": [{"admin": false}]},
    {"client": "alice", "call": "ui", "args": ["menu"]},
    {"client": "alice", "call": "expectState", "args": [{"menuButtons": ["lacks", "SERVER SETTINGS"]}]}
  ]
}
