{
  "description": "Experimental latency knobs: each flag toggled with the live loop running; overlay numbers recorded in the JSON (not asserted)",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"client": "alice", "call": "cvar", "args": ["cl_showfps", 1]},
    {"client": "alice", "call": "live", "args": [1200]},
    {"client": "alice", "call": "expectState", "args": [{"latency.flags.r_gpu_fence": 0, "latency.ticksPerSec": [">", 0]}]},
    {"snapshot": "baseline"},
    {"client": "alice", "call": "cvar", "args": ["r_gpu_fence", 1]},
    {"client": "alice", "call": "live", "args": [1200]},
    {"client": "alice", "call": "expectState", "args": [{"latency.flags.r_gpu_fence": 1}]},
    {"snapshot": "fence-1"},
    {"client": "alice", "call": "cvar", "args": ["r_gpu_fence", 2]},
    {"client": "alice", "call": "live", "args": [1200]},
    {"client": "alice", "call": "expectState", "args": [{"latency.flags.r_gpu_fence": 2}]},
    {"snapshot": "fence-2"},
    {"client": "alice", "call": "cvar", "args": ["r_gpu_fence", 0]},
    {"client": "alice", "call": "cvar", "args": ["r_late_input", 1]},
    {"client": "alice", "call": "live", "args": [1200]},
    {"client": "alice", "call": "expectState", "args": [{"latency.flags.r_gpu_fence": 0, "latency.flags.r_late_input": 1}]},
    {"snapshot": "late-latch"},
    {"client": "alice", "call": "cvar", "args": ["r_late_input", 0]},
    {"client": "alice", "call": "cvar", "args": ["r_finish", 1]},
    {"client": "alice", "call": "live", "args": [1200]},
    {"client": "alice", "call": "expectState", "args": [{"latency.flags.r_late_input": 0, "latency.flags.r_finish": 1}]},
    {"snapshot": "finish"},
    {"client": "alice", "call": "cvar", "args": ["r_finish", 0]},
    {"client": "alice", "call": "cvar", "args": ["cl_loop", "unlocked"]},
    {"client": "alice", "call": "live", "args": [1200]},
    {"client": "alice", "call": "expectState", "args": [{"latency.flags.r_finish": 0, "latency.flags.cl_loop": "unlocked"}]},
    {"snapshot": "unlocked"},
    {"client": "alice", "call": "cvar", "args": ["cl_loop", "raf"]},
    {"client": "alice", "call": "cvar", "args": ["r_desynchronized", 1]},
    {"client": "alice", "call": "ui", "args": ["options"]},
    {"client": "alice", "call": "live", "args": [800]},
    {"client": "alice", "call": "scroll", "args": [".options", 700]},
    {"client": "alice", "call": "expectState", "args": [{"screen": "ingame", "latency.flags.cl_loop": "raf", "latency.flags.r_desynchronized": 1}]},
    {"snapshot": "options-panel"},
    {"client": "alice", "call": "cvar", "args": ["r_desynchronized", 0]}
  ]
}
