    {"step": 10},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "live"}]},
    {"client": "alice", "call": "exec", "args": ["give prompt"]},
    {"wait": 200},
    {"step": 40},
    {"client": "alice", "call": "set", "args": [{"pos": [22, 0, -22], "yaw": 1.5708, "pitch": -0.1}]},
    {"client": "bob", "call": "set", "args": [{"pos": [23, 0, -25], "yaw": 2.356, "pitch": -0.25}]},
    {"step": 30},
    {"client": "alice", "call": "hold", "args": [[], true]},
    {"client": "alice", "call": "set", "args": [{"yaw": 1.35}]},
    {"step": 10},
    {"client": "alice", "call": "set", "args": [{"yaw": 1.45}]},
    {"step": 10},
    {"client": "alice", "call": "set", "args": [{"yaw": 1.55}]},
    {"step": 10},
    {"client": "alice", "call": "set", "args": [{"yaw": 1.65}]},
    {"step": 10},
    {"client": "alice", "call": "set", "args": [{"yaw": 1.75}]},
    {"step": 10},
    {"client": "alice", "call": "set", "args": [{"yaw": 1.85}]},
    {"step": 10},
    {"client": "alice", "call": "hold", "args": [[], false]},
    {"step": 40},
    {"client": "alice", "call": "set", "args": [{"pos": [22, 0, -22], "yaw": 1.5708, "pitch": -0.9}]},
    {"step": 20},
    {"client": "alice", "call": "hold", "args": [[], true]},
    {"step": 40},
    {"client": "alice", "call": "hold", "args": [[], false]},
    {"step": 120},
    {"client": "alice", "call": "expectState", "args": [{"debris.holes": [">", 10], "debris.casings": [">", 10], "debris.flying": 0, "marks.decals": [">", 10], "marks.bits": [">", 10], "marks.draws": 2}]},
    {"client": "bob", "call": "waitState", "args": [{"debris.holes": [">", 10], "debris.casings": [">", 10]}]},
    {"client": "alice", "call": "set", "args": [{"pos": [23.5, 0, -20.5], "yaw": 1.166, "pitch": -0.3}]},
    {"step": 2},
    {"snapshot": "holes", "clients": ["alice", "bob"]},
    {"client": "alice", "call": "set", "args": [{"pos": [23.8, 0, -22], "yaw": 1.5708, "pitch": -0.7}]},
    {"step": 2},
    {"snapshot": "casings", "clients": ["alice"]},
    {"client": "alice", "call": "set", "args": [{"pos": [21.1, 0, -22.1], "yaw": 1.5708, "pitch": 0.12}]},
    {"step": 2},
    {"snapshot": "closeup", "clients": ["alice"]},
    {"wait": 16000},
    {"step": 10},
    {"client": "alice", "call": "waitState", "args": [{"round.n": 2}, 8000]},
    {"step": 5},
