    {"wait": 300}, {"step": 10},
    {"client": "alice", "call": "exec", "args": ["give prompt"]},
    {"wait": 200}, {"step": 40},
    {"client": "alice", "call": "waitState", "args": [{"hud.weapon": "The Prompt", "hud.canBuy": true}]},
    {"client": "alice", "call": "keyTap", "args": ["KeyB"]}, {"step": 2},
    {"client": "alice", "call": "keyTap", "args": ["Digit5"]}, {"step": 2},
    {"client": "alice", "call": "keyTap", "args": ["Digit2"]}, {"wait": 200}, {"step": 40},
    {"client": "alice", "call": "waitState", "args": [{"hud.helmet": true, "hud.buyMenu": false}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.weapon": "The Prompt"}]},
    {"client": "alice", "call": "keyTap", "args": ["KeyB"]}, {"step": 2},
    {"client": "alice", "call": "keyTap", "args": ["Digit1"]}, {"step": 2},
    {"client": "alice", "call": "keyTap", "args": ["Digit2"]}, {"wait": 200}, {"step": 40},
    {"client": "alice", "call": "waitState", "args": [{"hud.buyMenu": false}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.weapon": "The Prompt"}]},
    {"client": "alice", "call": "keyTap", "args": ["KeyB"]}, {"step": 2},
    {"client": "alice", "call": "keyTap", "args": ["Digit5"]}, {"step": 2},
    {"client": "alice", "call": "keyTap", "args": ["Digit3"]}, {"wait": 200}, {"step": 40},
    {"client": "alice", "call": "waitState", "args": [{"hud.shades": true, "hud.buyMenu": false}]},
    {"client": "alice", "call": "expectState", "args": [{"hud.weapon": "The Prompt"}]},
    {"snapshot": "after-buys", "clients": ["alice"]}
  ]
