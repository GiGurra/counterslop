{
  "description": "Spectator follows players in first person: their view angles, weapon viewmodel, crosshair and a HUD with name, HP, weapon and ammo; next player",
  "clients": ["alice", "bob", "cam"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "cam", "call": "join", "args": ["cam", "spec"]},
    {"client": "alice", "call": "set", "args": [{"pos": [-14, 0, 6], "yaw": 0, "pitch": -0.05}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-14, 0, 0], "yaw": 3.1416, "pitch": 0.1}]},
    {"wait": 400},
    {"step": 4},
    {"client": "cam", "call": "observe", "args": [{"mode": "first", "follow": "alice"}]},
    {"step": 2},
    {"snapshot": "follow-alice", "clients": ["cam"]},
    {"client": "cam", "call": "observe", "args": [{"next": 1}]},
    {"step": 2},
    {"snapshot": "next-bob", "clients": ["cam"]}
  ]
}
