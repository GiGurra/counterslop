{
  "description": "Team starts on de_stack: Vibe Coders in the garage under the ground floor, Artisans in the pen on the roof; each spawn has a pad in the team colour and the buy zone is outlined; the buy menu works only inside it, warmup prices are real (full money)",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", null]},
    {"client": "alice", "call": "exec", "args": ["changelevel de_stack"]},
    {"wait": 400},
    {"client": "alice", "call": "team", "args": ["artisan"]},
    {"client": "bob", "call": "join", "args": ["bob", "vibe"]},
    {"wait": 300},
    {"step": 20},
    {"client": "alice", "call": "expectState", "args": [{"map": "de_stack", "me.pos.1": ["~", [8, 0.1]], "me.pos.0": [">", 18], "hud.canBuy": true, "hud.money": 16000}]},
    {"client": "bob", "call": "expectState", "args": [{"me.pos.1": ["~", [-4, 0.1]], "me.pos.0": ["<", -10], "hud.canBuy": true}]},
    {"snapshot": "vibe-start", "clients": ["bob"]},
    {"client": "bob", "call": "keyTap", "args": ["KeyB"]},
    {"step": 3},
    {"client": "bob", "call": "keyTap", "args": ["Digit5"]},
    {"step": 3},
    {"client": "bob", "call": "expectState", "args": [{"hud.buyMenu": true, "hud.buyItems": ["has", "Hoodie $650"]}]},
    {"snapshot": "buy-prices", "clients": ["bob"]},
    {"client": "bob", "call": "keyTap", "args": ["KeyB"]},
    {"client": "bob", "call": "set", "args": [{"pos": [0, 0, 0]}]},
    {"wait": 300},
    {"step": 20},
    {"client": "bob", "call": "expectState", "args": [{"hud.canBuy": false}]},
    {"client": "alice", "call": "camera", "args": [{"eye": [14, 16, -1], "yaw": -1.5708, "pitch": -0.8}]},
    {"step": 2},
    {"snapshot": "pads-overview", "clients": ["alice"]}
  ]
}
