{
  "description": "Replay player (docs/replays.md): bob kills alice in a live round; bob then plays the server's recording of it as a dropped file would: the bar with the kill marked on the timeline, the observer cameras (first person on a player, chase, overview), seek back before the kill and play through it at 4x (the kill feed shows it again), pause, and leave back to the menu; then the Replays screen lists the server's rounds (/replays.json) and playing round 1 from it runs to its end",
  "clients": ["alice", "bob"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"client": "alice", "call": "join", "args": ["alice", "vibe"]},
    {"client": "bob", "call": "join", "args": ["bob", "artisan"]},
    {"client": "alice", "call": "exec", "args": ["mp_freezetime 0; mp_roundtime 3; mp_respawn 0"]},
    {"wait": 300},
    {"client": "alice", "call": "exec", "args": ["mp_warmup_end"]},
    {"wait": 300},
    {"step": 5},
    {"client": "alice", "call": "waitState", "args": [{"round.ph": "live"}]},
    {"client": "alice", "call": "set", "args": [{"pos": [-20, 0, 8], "yaw": 0, "pitch": 0}]},
    {"client": "bob", "call": "set", "args": [{"pos": [-12, 0, 8], "yaw": 1.5708, "pitch": -0.05}]},
    {"wait": 400},
    {"client": "bob", "call": "exec", "args": ["give linter"]},
    {"wait": 300},
    {"client": "bob", "call": "hold", "args": [[], true]},
    {"step": 80},
    {"client": "bob", "call": "hold", "args": [[], false]},
    {"wait": 600},
    {"client": "alice", "call": "expectState", "args": [{"hud.hp": 0}]},
    {"client": "bob", "replay": 1},
    {"client": "bob", "call": "expectState", "args": [{"screen": "playing", "replay.count": 1, "replay.paused": false, "replay.marks.length": [">", 0], "replay.notes.0": ["has", "still being recorded"], "replay.drawn.length": 2}]},
    {"step": 30},
    {"client": "bob", "call": "expectState", "args": [{"replay.t": [">", 0.4], "replay.observer.mode": "first", "replay.observer.target": [">", 0]}]},
    {"snapshot": "first-person", "clients": ["bob"]},
    {"client": "bob", "call": "exec", "args": ["replay cam"]},
    {"step": 2},
    {"snapshot": "chase", "clients": ["bob"]},
    {"client": "bob", "call": "exec", "args": ["replay cam; replay cam; replay seek 0; replay speed 4"]},
    {"step": 2},
    {"client": "bob", "call": "expectState", "args": [{"replay.cam": "overview", "replay.speed": 4, "replay.t": ["<", 0.2]}]},
    {"step": 150},
    {"client": "bob", "call": "expectState", "args": [{"replay.feed": ["has", "alice"]}]},
    {"client": "bob", "call": "exec", "args": ["replay pause"]},
    {"snapshot": "overview-after-kill", "clients": ["bob"]},
    {"client": "bob", "call": "expectState", "args": [{"replay.paused": true}]},
    {"client": "bob", "call": "exec", "args": ["replay stop"]},
    {"step": 2},
    {"client": "bob", "call": "expectState", "args": [{"screen": "menu", "replay": null}]},
    {"client": "bob", "call": "ui", "args": ["replays"]},
    {"snapshot": "replays-menu", "clients": ["bob"]},
    {"client": "bob", "call": "replayPick", "args": [0]},
    {"step": 10},
    {"client": "bob", "call": "expectState", "args": [{"screen": "playing", "replay.count": 1, "replay.name": ["has", "round 1"], "replay.marks.length": [">", 0], "replay.drawn.length": 2}]},
    {"client": "bob", "call": "exec", "args": ["replay seek +60"]},
    {"step": 2},
    {"client": "bob", "call": "expectState", "args": [{"replay.ended": true, "replay.paused": true}]},
    {"snapshot": "from-server-list-end", "clients": ["bob"]},
    {"client": "bob", "call": "exec", "args": ["replay stop"]}
  ]
}
