{
  "description": "Weapon keys through the real input path: R reloads, 1/2/3 switch, Q last weapon, wheel cycles (fresh settings)",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"wait": 300},
    {"client": "alice", "call": "set", "args": [{"pos": [-20, 0, 8], "yaw": 0}]},
    {"step": 30},
    {"client": "alice", "call": "hold", "args": [[], true]},
    {"step": 20},
    {"client": "alice", "call": "hold", "args": [[], false]},
    {"step": 2},
    {"client": "alice", "call": "keyTap", "args": ["KeyR"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"reloadText": true}]},
    {"step": 300},
    {"wait": 300},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"reloadText": false}]},
    {"client": "alice", "call": "keyTap", "args": ["Digit2"]},
    {"step": 2},
    {"wait": 300},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"hud.weapon": "The Stub"}]},
    {"client": "alice", "call": "keyTap", "args": ["Digit3"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"hud.weapon": "Mechanical Keyboard"}]},
    {"client": "alice", "call": "keyTap", "args": ["KeyQ"]},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"hud.weapon": "The Stub"}]},
    {"client": "alice", "call": "keyTap", "args": ["Digit1"]},
    {"step": 2},
    {"wait": 300},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"hud.weapon": "The Prompt"}]},
    {"client": "alice", "call": "expectActionsWired"},
    {"client": "alice", "call": "keyTap", "args": ["KeyG"]},
    {"step": 2},
    {"wait": 300},
    {"step": 2},
    {"client": "alice", "call": "expectState", "args": [{"hud.weapon": "The Stub"}]},
    {"snapshot": "dropped-primary"}
  ]
}
