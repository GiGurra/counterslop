{
  "description": "SlopVox announcer from the console: list lines, say one, speak raw phonemes (headless Chrome renders but can't be heard)",
  "clients": ["alice"],
  "steps": [
    {"client": "*", "call": "time", "args": [40]},
    {"join": true},
    {"client": "alice", "call": "ui", "args": ["console"]},
    {"client": "alice", "call": "exec", "args": ["say_announcer"]},
    {"client": "alice", "call": "exec", "args": ["say_announcer monster_slop"]},
    {"client": "alice", "call": "exec", "args": ["vox @taunt ~2 HH EH1 L OW1 _ W ER1 L D"]},
    {"client": "alice", "call": "expectState", "args": [{"console": true, "consoleLog.lines": [">", 10], "caption.shout": "Mo-mo-mo-MONSTER SLOP!"}]},
    {"snapshot": "announcer"}
  ]
}
